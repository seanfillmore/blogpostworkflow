{%- comment -%}
  Giveaway lander entry form.

  Posts to a first-party subdomain, matching theme/snippets/rsc-rum.liquid. An
  ad-blocker-filtered host would silently drop entries we paid ~$2.50 each for,
  which is the same mistake the RUM collector already learned once.

  Three fields only. Every extra field on a cold lander costs opt-in rate; the
  survey happens on the next page, after the entry is safely recorded.

  ── THIS TEMPLATE HIDES THE THEME CHROME ──────────────────────────────────
  The CSS below hides the theme's header, announcement bar, footer and mobile
  dock on this page only. That is deliberate: this is a paid lander with one
  job, and the site nav offered eight ways to leave it. The announcement bar
  had to go for a second reason — it advertises "Free Shipping on Orders Over
  $45" on a page whose entire legal basis is NO PURCHASE NECESSARY.

  Consequence to remember: anything else added to the page.giveaway template
  inherits this stripped chrome. That is intended here and surprising anywhere
  else.

  Sections are matched with [id$="__header"] rather than the full
  #shopify-section-sections--19709746938026__header, because that numeric id is
  regenerated by Shopify and hard-coding it silently breaks the page.
{%- endcomment -%}

{%- liquid
  assign endpoint = 'https://entries.realskincare.com/api/giveaway'
  assign hero = 'https://cdn.shopify.com/s/files/1/0270/1911/6579/files/real_skin_care_bar_soap_unscented_1.jpg?v=1733530066'
  assign logo = 'https://cdn.shopify.com/s/files/1/0270/1911/6579/files/Logo_3c129581-8a9a-426f-9f94-8b5d96a43e16.png'
-%}

<style>
  /* Strip the theme chrome. See the comment block above before removing. */
  [id$="__header"],
  [id$="__announcement-bar"],
  [id$="__footer"],
  [id$="__mobile-dock"] { display: none !important; }

  /* Brand kit: black #000000, sand #EDE5D8, green #AEDEAC, grey #EDEDED.
     The kit allows ONE accent element per page — it is spent on the button's
     hover/focus state, nothing else. Type inherits the theme's Cabin/Outfit
     variables so this page loads no additional fonts. */
  .gv-entry {
    --gv-ink: #000000;
    --gv-sand: #EDE5D8;
    --gv-green: #AEDEAC;
    --gv-line: #EDEDED;
    --gv-muted: #5b5b5b;
    max-width: 1080px;
    margin: 0 auto;
    padding: 24px 20px 64px;
    font-family: var(--font-body-family, 'Outfit', sans-serif);
    color: var(--gv-ink);
  }

  .gv-brand { text-align: center; padding: 4px 0 22px; }
  .gv-brand img { height: 34px; width: auto; }

  /* Mobile order is headline → image → form. The headline has to lead: a soap
     photo alone reads as a product page, and a square hero pushed the H1 ~495px
     down, below the fold on a 390x844 phone. */
  .gv-grid { display: grid; gap: 22px; }

  .gv-shot {
    background: var(--gv-sand);
    border-radius: 4px;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .gv-shot img { width: 86%; height: auto; mix-blend-mode: multiply; }

  .gv-entry h1 {
    font-family: var(--font-heading-family, 'Cabin', sans-serif);
    font-size: clamp(2rem, 7vw, 3.25rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    text-wrap: balance;
  }
  /* The count is the offer. It gets the emphasis, not the verb. */
  .gv-entry h1 b { font-weight: 700; }

  .gv-sub {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--gv-muted);
    margin: 0;
    max-width: 42ch;
  }

  .gv-form { display: grid; gap: 14px; margin: 0 0 24px; }
  .gv-form label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .gv-form label span { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--gv-muted); }
  .gv-form input {
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 1rem;
    padding: 14px 14px;
    border: 1px solid var(--gv-line);
    border-radius: 3px;
    background: #fff;
    color: var(--gv-ink);
  }
  .gv-form input:focus-visible {
    outline: 2px solid var(--gv-ink);
    outline-offset: 1px;
    border-color: var(--gv-ink);
  }

  .gv-form button {
    font-family: var(--font-heading-family, 'Cabin', sans-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 17px 20px;
    border: 0;
    border-radius: 3px;
    background: var(--gv-ink);
    color: #fff;
    cursor: pointer;
    transition: background-color 140ms ease, color 140ms ease;
  }
  .gv-form button:hover,
  .gv-form button:focus-visible { background: var(--gv-green); color: var(--gv-ink); }
  .gv-form button:focus-visible { outline: 2px solid var(--gv-ink); outline-offset: 2px; }
  .gv-form button[disabled] { opacity: 0.55; cursor: default; }

  .gv-error {
    margin: 0;
    padding: 12px 14px;
    border-left: 3px solid var(--gv-ink);
    background: var(--gv-line);
    font-size: 0.9375rem;
  }

  .gv-stack {
    list-style: none;
    margin: 0 0 22px;
    padding: 22px;
    background: var(--gv-sand);
    border-radius: 4px;
    display: grid;
    gap: 12px;
    font-size: 1rem;
    line-height: 1.45;
  }
  .gv-stack li { display: grid; grid-template-columns: 2.6rem 1fr; gap: 14px; align-items: baseline; }
  .gv-stack b {
    font-family: var(--font-heading-family, 'Cabin', sans-serif);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .gv-fine { font-size: 0.8125rem; line-height: 1.55; color: var(--gv-muted); margin: 0; }
  .gv-fine a { color: var(--gv-ink); }

  @media (min-width: 900px) {
    .gv-entry { padding-top: 40px; }
    .gv-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: "shot head" "shot copy";
      grid-template-rows: auto 1fr;
      column-gap: 56px;
      row-gap: 0;
      align-items: start;
    }
    .gv-head { grid-area: head; }
    .gv-shot { grid-area: shot; aspect-ratio: 1 / 1; position: sticky; top: 32px; }
    /* row-gap is 0 so the sticky image aligns to the headline; the breathing
       room between subhead and the first field is restored here instead. */
    .gv-copy { grid-area: copy; margin-top: 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gv-form button { transition: none; }
  }
</style>

<section class="gv-entry" id="gv-entry">
  <div class="gv-brand">
    {%- comment -%}
      The wordmark is a Files upload, not a theme asset, so `asset_url` 404s on
      it. Same image the theme header serves, on the canonical CDN host and
      requested at 2x. width/height are the natural 925x487 scaled to 34px tall
      — both attributes are required, or the logo reflows the page as it loads.
    {%- endcomment -%}
    <img src="{{ logo }}?height=68" alt="Real Skin Care" width="65" height="34" loading="eager">
  </div>

  <div class="gv-grid">
    <div class="gv-head">
      <h1>{{ section.settings.headline }}</h1>
      <p class="gv-sub">{{ section.settings.subhead }}</p>
    </div>

    <div class="gv-shot">
      <img src="{{ hero }}&width=900" alt="A bar of Pure Unscented Moisturizing Coconut Soap" width="900" height="900" loading="eager">
    </div>

    <div class="gv-copy">
      <form class="gv-form" novalidate>
        <div>
          <label for="gv-email">Email</label>
          <input id="gv-email" name="email" type="email" required autocomplete="email" inputmode="email">
        </div>

        <div>
          <label for="gv-first">First name</label>
          <input id="gv-first" name="firstName" type="text" required autocomplete="given-name">
        </div>

        <div>
          <label for="gv-ref">Referred by a friend? <span>Their email, optional</span></label>
          <input id="gv-ref" name="referredBy" type="email" autocomplete="off" inputmode="email">
        </div>

        <button type="submit">Enter free</button>
        <p class="gv-error" hidden role="alert"></p>
      </form>

      <ul class="gv-stack">
        <li><b>36</b><span>bars of Pure Unscented soap, delivered over three years</span></li>
        <li><b>3</b><span>Sensitive Skin Moisturizing Sets, one a year</span></li>
        <li><b>2</b><span>winners — you, and whoever referred you</span></li>
      </ul>

      <p class="gv-fine">
        A $536 prize. Entering is free.
        No purchase necessary. Purchases do not earn entries.
        <a href="/pages/giveaway-official-rules">Official rules</a>.
        This promotion is not sponsored, endorsed, or administered by Meta.
      </p>
    </div>
  </div>
</section>

<script>window.RSC_GIVEAWAY_ENDPOINT = {{ endpoint | json }};</script>
<script src="{{ 'giveaway.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Giveaway entry",
  "settings": [
    { "id": "headline", "type": "text", "label": "Headline", "default": "Win 3 years of soap." },
    { "id": "subhead", "type": "text", "label": "Subhead", "default": "One ingredient: saponified coconut oil. Nothing added, nothing masked. Entering takes about ten seconds." }
  ],
  "presets": [{ "name": "Giveaway entry" }]
}
{% endschema %}
