{%- comment -%}
  Homepage hero, two columns over a short, wide product photograph
  (Sean, 2026-10-06: the old hero filled the whole first screen on desktop and
  left dead space over the image).

  Desktop: headline + result bullets on the LEFT third, product headline,
  subheadline, live rating, price CTA and guarantee on the RIGHT third, the
  bottle in the middle. A soft light wash behind each column keeps dark text
  readable on the bright photo. Height is capped so the next section shows
  above the fold.

  Mobile: image first (short crop), then headline, rating, CTA, offer line,
  then the bullets, so the CTA is on the first screen.

  Prices and the rating are read live (all_products + Judge.me metafields);
  nothing numeric is baked into the copy.

  CAROUSEL (Sean, 2026-11-04): when "Promo slide" is enabled the hero becomes a
  two-slide carousel, the original slide first (it keeps the page's H1 and the
  eager LCP image) and the promo slide second (H2, lazy image). Scroll-snap does
  the sliding, so it swipes natively on phones; dots and arrows move it, it
  advances every 7s, and it stops for good on the first touch, click, hover or
  keyboard focus. No autoplay under prefers-reduced-motion. With the promo slide
  off, the markup is the single hero exactly as before.
{%- endcomment -%}

{%- assign p = all_products[section.settings.product_handle] -%}
{%- assign pack = all_products[section.settings.pack_handle] -%}
{%- assign rating = p.metafields.reviews.rating.value.rating | default: 0 -%}
{%- assign rating_count = p.metafields.reviews.rating_count | default: 0 -%}

{%- comment -%} "Buy N, get M free" only when the pack price divides into whole singles. {%- endcomment -%}
{%- assign offer = '' -%}
{%- if pack != blank and pack.available and p.price > 0 -%}
  {%- assign paid = pack.price | divided_by: p.price -%}
  {%- assign rem = pack.price | modulo: p.price -%}
  {%- assign units = section.settings.pack_units | plus: 0 -%}
  {%- if rem == 0 and paid > 0 and paid < units -%}
    {%- assign free = units | minus: paid -%}
    {%- assign offer = 'Buy ' | append: paid | append: ', get ' | append: free | append: ' free on the ' | append: units | append: '-pack' -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Desktop: the hero fills the screen up to 1920px wide and takes the image's own
  shape, so the photo is always shown whole (Sean, 2026-10-07: 1920 wide, fill
  the screen; no blurred side bars). Wider screens see the 1920 hero centred.
  A fixed-height full-bleed box had cropped the bottle cap at 1920px+.
{%- endcomment -%}
{%- assign hhs_ratio = section.settings.image_desktop.aspect_ratio | default: 2.357 -%}
{%- assign promo_on = false -%}
{%- if section.settings.promo_enabled and section.settings.promo_image_desktop != blank -%}{%- assign promo_on = true -%}{%- endif -%}
{%- if promo_on -%}
<div class="hhs-car" data-hhs-car style="--hhs-ratio: {{ hhs_ratio }};" role="region" aria-roledescription="carousel" aria-label="Featured">
  <div class="hhs-car__track" data-hhs-track>
{%- endif -%}
<section class="hhs{% if promo_on %} hhs--slide{% endif %}" {% if promo_on %}aria-roledescription="slide" aria-label="1 of 2" {% endif %}style="--hhs-ratio: {{ hhs_ratio }};" aria-label="{{ section.settings.heading | strip_html | escape }}">
  <div class="hhs__media">
    {%- if section.settings.image_desktop -%}
      <picture>
        {%- if section.settings.image_mobile -%}
          <source media="(max-width: 989px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }} 800w, {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w" sizes="100vw">
        {%- endif -%}
        <img src="{{ section.settings.image_desktop | image_url: width: 1920 }}"
             srcset="{{ section.settings.image_desktop | image_url: width: 1280 }} 1280w, {{ section.settings.image_desktop | image_url: width: 1920 }} 1920w, {{ section.settings.image_desktop | image_url: width: 2560 }} 2560w"
             sizes="100vw" alt="{{ section.settings.image_alt | escape }}"
             width="{{ section.settings.image_desktop.width }}" height="{{ section.settings.image_desktop.height }}"
             fetchpriority="high" loading="eager" class="hhs__img">
      </picture>
    {%- endif -%}
  </div>

  <div class="hhs__inner">
    <div class="hhs__col hhs__col--left">
      <h1 class="hhs__h1">{{ section.settings.heading }}</h1>
      <ul class="hhs__bullets">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="hhs__col hhs__col--right">
      <p class="hhs__kicker">{{ section.settings.kicker }}</p>
      <h2 class="hhs__h2">{{ section.settings.product_heading }}</h2>
      <p class="hhs__sub">{{ section.settings.subheading }}</p>
      {%- if rating_count > 0 -%}
        <p class="hhs__rating">
          <span class="hhs__stars" role="img" aria-label="{{ rating | round: 1 }} out of 5 stars">★★★★★</span>
          <span>{{ rating | round: 1 }} · {{ rating_count }} reviews</span>
        </p>
      {%- endif -%}
      <a class="hhs__cta button" href="{{ p.url | default: '/collections/all' }}">
        {{ section.settings.cta_label }} · from {{ p.price | money_without_trailing_zeros }}
      </a>
      {%- if offer != '' -%}<p class="hhs__offer">{{ offer }}</p>{%- endif -%}
      <p class="hhs__guarantee">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/></svg>
        {{ section.settings.guarantee }}
      </p>
    </div>
  </div>
</section>

{%- if promo_on -%}
  {%- assign pp = all_products[section.settings.promo_pack_handle] -%}
  {%- comment -%} A dated variant of the promo (Black Friday 2026) swaps in on its own
      between promo_alt_start and promo_alt_end (unix seconds), then swaps back. {%- endcomment -%}
  {%- assign pr_kicker = section.settings.promo_kicker -%}{%- assign pr_heading = section.settings.promo_heading -%}
  {%- assign pr_text = section.settings.promo_text -%}{%- assign pr_add_label = section.settings.promo_add_label -%}
  {%- assign pr_add_url = section.settings.promo_add_url -%}{%- assign pr_fine = section.settings.promo_fine -%}
  {%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
  {%- assign alt_a = section.settings.promo_alt_start | plus: 0 -%}{%- assign alt_b = section.settings.promo_alt_end | plus: 0 -%}
  {%- if alt_a > 0 and now_s >= alt_a and now_s <= alt_b -%}
    {%- assign pr_kicker = section.settings.promo_alt_kicker -%}{%- assign pr_heading = section.settings.promo_alt_heading -%}
    {%- assign pr_text = section.settings.promo_alt_text -%}{%- assign pr_add_label = section.settings.promo_alt_add_label -%}
    {%- assign pr_add_url = section.settings.promo_alt_add_url -%}{%- assign pr_fine = section.settings.promo_alt_fine -%}
  {%- endif -%}
  <section class="hhs hhs--slide hhs--promo" aria-roledescription="slide" aria-label="2 of 2">
    <div class="hhs__media">
      <picture>
        {%- if section.settings.promo_image_mobile -%}
          <source media="(max-width: 989px)" srcset="{{ section.settings.promo_image_mobile | image_url: width: 800 }} 800w, {{ section.settings.promo_image_mobile | image_url: width: 1200 }} 1200w" sizes="100vw">
        {%- endif -%}
        <img src="{{ section.settings.promo_image_desktop | image_url: width: 1920 }}"
             srcset="{{ section.settings.promo_image_desktop | image_url: width: 1280 }} 1280w, {{ section.settings.promo_image_desktop | image_url: width: 1920 }} 1920w, {{ section.settings.promo_image_desktop | image_url: width: 2560 }} 2560w"
             sizes="100vw" alt="{{ section.settings.promo_image_alt | escape }}"
             width="{{ section.settings.promo_image_desktop.width }}" height="{{ section.settings.promo_image_desktop.height }}"
             loading="lazy" class="hhs__img hhs__img--promo">
      </picture>
    </div>
    <div class="hhs__inner">
      <div class="hhs__col hhs__col--left hhs__col--promo">
        <p class="hhs__kicker">{{ pr_kicker }}</p>
        <h2 class="hhs__h1 hhs__h1--promo">{{ pr_heading }}</h2>
        <p class="hhs__sub">{{ pr_text }}</p>
        <a class="hhs__cta button" href="{{ section.settings.promo_cta_url }}">{{ section.settings.promo_cta_label }}</a>
        {%- if pr_add_label != blank and pr_add_url != blank -%}
          <p class="hhs__offer"><a class="hhs__link" href="{{ pr_add_url }}">{{ pr_add_label }}</a></p>
        {%- endif -%}
        {%- if pp != blank and pp.available -%}
          <p class="hhs__guarantee">{{ section.settings.promo_pack_label }}
            {%- assign pv = pp.selected_or_first_available_variant -%}{%- assign pv_id = section.settings.promo_pack_variant | plus: 0 -%}{%- for v in pp.variants -%}{%- if v.id == pv_id -%}{%- assign pv = v -%}{%- endif -%}{%- endfor -%}<a class="hhs__link" href="{{ pp.url }}{% if section.settings.promo_pack_variant != blank %}?variant={{ section.settings.promo_pack_variant }}{% endif %}">{{ pv.price | money_without_trailing_zeros }}</a></p>
        {%- endif -%}
        {%- if pr_fine != blank -%}<p class="hhs__fine">{{ pr_fine }}</p>{%- endif -%}
      </div>
    </div>
  </section>
  </div>
  <div class="hhs-car__nav">
    <button type="button" class="hhs-car__arrow" data-hhs-prev aria-label="Previous slide">&#8249;</button>
    <button type="button" class="hhs-car__dot" data-hhs-dot="0" aria-label="Show slide 1" aria-current="true"></button>
    <button type="button" class="hhs-car__dot" data-hhs-dot="1" aria-label="Show slide 2"></button>
    <button type="button" class="hhs-car__arrow" data-hhs-next aria-label="Next slide">&#8250;</button>
  </div>
</div>
<script>
(function () {
  var car = document.currentScript.previousElementSibling;
  if (!car || !car.hasAttribute('data-hhs-car')) return;
  var track = car.querySelector('[data-hhs-track]');
  var slides = track.children, dots = car.querySelectorAll('[data-hhs-dot]');
  var cur = 0, timer = null;
  // Slides differ in height on phones; size the track to the slide in view so no gap shows under a short one.
  function fit() { track.style.height = slides[cur].offsetHeight + 'px'; }
  function go(i) { cur = (i + slides.length) % slides.length; track.scrollTo({ left: slides[cur].offsetLeft, behavior: 'smooth' }); fit(); }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  track.addEventListener('scroll', function () {
    var i = Math.round(track.scrollLeft / track.clientWidth);
    if (i !== cur && i >= 0 && i < slides.length) { cur = i; fit(); }
    for (var d = 0; d < dots.length; d++) dots[d].setAttribute('aria-current', d === cur ? 'true' : 'false');
  }, { passive: true });
  for (var d = 0; d < dots.length; d++) dots[d].addEventListener('click', function (e) { stop(); go(+e.currentTarget.getAttribute('data-hhs-dot')); });
  car.querySelector('[data-hhs-prev]').addEventListener('click', function () { stop(); go(cur - 1); });
  car.querySelector('[data-hhs-next]').addEventListener('click', function () { stop(); go(cur + 1); });
  ['pointerdown', 'mouseenter', 'focusin', 'touchstart', 'wheel'].forEach(function (ev) { car.addEventListener(ev, stop, { passive: true, once: true }); });
  fit(); window.addEventListener('resize', fit); window.addEventListener('load', fit);
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(function () { go(cur + 1); }, 7000);
})();
</script>
{%- endif -%}

<style>
  .hhs{position:relative;background:#f4f2ee;overflow:hidden;color:#151515}
  .hhs__media,.hhs__media picture{display:block}
  .hhs__img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 60%}
  .hhs__h1{font-size:clamp(28px,2.6vw,42px);line-height:1.12;margin:0 0 18px;letter-spacing:-.01em;color:#151515}
  .hhs__bullets{list-style:none;margin:0;padding:0;display:grid;gap:10px}
  .hhs__bullets li{display:flex;gap:10px;align-items:flex-start;font-size:clamp(15px,1.15vw,18px);line-height:1.4}
  .hhs__bullets svg{flex:0 0 auto;margin-top:3px;color:#3f7a33}
  .hhs__kicker{margin:0 0 6px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:#3f7a33}
  .hhs__h2{font-size:clamp(22px,1.9vw,30px);line-height:1.15;margin:0 0 8px;color:#151515}
  .hhs__sub{margin:0 0 12px;font-size:clamp(15px,1.1vw,17px);line-height:1.45;color:#2f3133}
  .hhs__rating{display:flex;align-items:center;gap:8px;margin:0 0 14px;font-size:14px;color:#2f3133}
  .hhs__stars{color:#151515;letter-spacing:2px}
  .hhs__cta{display:inline-flex;justify-content:center;width:100%;text-align:center}
  .hhs__offer{margin:10px 0 0;font-size:14px;font-weight:700;color:#151515}
  .hhs__guarantee{display:flex;align-items:center;gap:6px;margin:8px 0 0;font-size:13px;color:#2f3133}

  .hhs-car{position:relative;max-width:1920px;margin:0 auto}
  .hhs-car__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;align-items:flex-start}
  .hhs-car__track::-webkit-scrollbar{display:none}
  .hhs--slide{flex:0 0 100%;scroll-snap-align:start;scroll-snap-stop:always}
  .hhs-car__track{transition:height .3s ease;background:#f4f2ee}
  .hhs-car__nav{position:absolute;left:50%;transform:translateX(-50%);bottom:14px;z-index:2;display:flex;align-items:center;gap:10px;padding:5px 10px;border-radius:999px;background:rgba(250,249,246,.85)}
  .hhs-car__dot{width:10px;height:10px;border-radius:50%;border:1px solid #151515;background:transparent;padding:0;cursor:pointer}
  .hhs-car__dot[aria-current="true"]{background:#151515}
  .hhs-car__arrow{border:0;background:transparent;font-size:26px;line-height:1;padding:0 8px;cursor:pointer;color:#151515}
  .hhs__link{color:#151515;text-decoration:underline;font-weight:700}
  .hhs__fine{margin:10px 0 0;font-size:12px;line-height:1.4;color:#5a5c5e}
  .hhs--promo .hhs__kicker{display:block}

  @media screen and (min-width:990px){
    .hhs{max-width:1920px;margin:0 auto;height:max(460px,calc(min(100vw,1920px) / var(--hhs-ratio)))}
    .hhs__media{position:absolute;inset:0}
    .hhs__media picture{position:relative;height:100%}
    .hhs__inner{position:relative;height:100%;max-width:1400px;margin:0 auto;padding:0 40px;
      display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,22%) minmax(0,1fr);align-items:center}
    .hhs__col{background:rgba(250,249,246,.82);backdrop-filter:blur(2px);border-radius:14px;padding:26px 28px;max-width:430px}
    .hhs__col--left{grid-column:1;justify-self:start}
    .hhs__col--right{grid-column:3;justify-self:end}
    .hhs--slide{max-width:none}
  }
  @media screen and (max-width:989px){
    .hhs__media{height:clamp(300px,92vw,480px);overflow:hidden}
    .hhs__media picture{height:100%}
    .hhs__img{object-position:50% 30%}
    .hhs__inner{padding:22px 16px 26px}
    .hhs__col--left{display:contents}
    .hhs__inner{display:flex;flex-direction:column}
    .hhs__h1{order:1;font-size:28px;margin-bottom:10px}
    .hhs__col--right{order:2}
    .hhs__kicker,.hhs__h2{display:none}
    .hhs__bullets{order:3;margin-top:20px}
    .hhs--promo .hhs__col--promo{display:block}
    .hhs--promo .hhs__h1--promo{font-size:26px}
    .hhs__img--promo{object-position:50% 70%}
    .hhs-car__nav{bottom:auto;left:auto;right:12px;transform:none;top:calc(clamp(300px,92vw,480px) - 44px)}
  }
</style>

{% schema %}
{
  "name": "Home • Split hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Left headline (H1)", "default": "Skincare for skin that reacts to everything else." },
    { "type": "text", "id": "kicker", "label": "Right kicker", "default": "Our best seller" },
    { "type": "text", "id": "product_heading", "label": "Right headline", "default": "Coconut Body Lotion" },
    { "type": "text", "id": "subheading", "label": "Right subheadline", "default": "Six ingredients you can read. Made in small batches in the USA." },
    { "type": "text", "id": "product_handle", "label": "Product handle (CTA, price, rating)", "default": "coconut-lotion" },
    { "type": "text", "id": "pack_handle", "label": "Pack handle (offer line)", "default": "coconut-lotion-4-pack" },
    { "type": "number", "id": "pack_units", "label": "Units in the pack", "default": 4 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Body Lotion" },
    { "type": "text", "id": "guarantee", "label": "Guarantee line", "default": "30-day money-back guarantee" },
    { "type": "image_picker", "id": "image_desktop", "label": "Image (desktop, wide 21:9)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile, 4:5)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Real Skin Care Pure Unscented body lotion on a bathroom vanity" },
    { "type": "header", "content": "Promo slide (makes a carousel)" },
    { "type": "checkbox", "id": "promo_enabled", "label": "Show promo slide", "default": false },
    { "type": "text", "id": "promo_kicker", "label": "Promo kicker" },
    { "type": "text", "id": "promo_heading", "label": "Promo headline (H2)" },
    { "type": "text", "id": "promo_text", "label": "Promo text" },
    { "type": "text", "id": "promo_cta_label", "label": "Promo button label" },
    { "type": "text", "id": "promo_cta_url", "label": "Promo button link" },
    { "type": "text", "id": "promo_add_label", "label": "Secondary link label" },
    { "type": "text", "id": "promo_add_url", "label": "Secondary link URL" },
    { "type": "text", "id": "promo_pack_handle", "label": "Pack handle (live price line)" },
    { "type": "text", "id": "promo_pack_label", "label": "Pack line label" },
    { "type": "text", "id": "promo_pack_variant", "label": "Pack variant id (link opens this variant)" },
    { "type": "text", "id": "promo_fine", "label": "Promo fine print" },
    { "type": "image_picker", "id": "promo_image_desktop", "label": "Promo image (desktop, wide 21:9)" },
    { "type": "image_picker", "id": "promo_image_mobile", "label": "Promo image (mobile, 4:5)" },
    { "type": "text", "id": "promo_image_alt", "label": "Promo image alt text" },
    { "type": "header", "content": "Dated promo variant" },
    { "type": "text", "id": "promo_alt_start", "label": "Start (unix seconds)" },
    { "type": "text", "id": "promo_alt_end", "label": "End (unix seconds)" },
    { "type": "text", "id": "promo_alt_kicker", "label": "Kicker" },
    { "type": "text", "id": "promo_alt_heading", "label": "Headline (H2)" },
    { "type": "text", "id": "promo_alt_text", "label": "Text" },
    { "type": "text", "id": "promo_alt_add_label", "label": "Secondary link label" },
    { "type": "text", "id": "promo_alt_add_url", "label": "Secondary link URL" },
    { "type": "text", "id": "promo_alt_fine", "label": "Fine print" }
  ],
  "blocks": [
    { "type": "bullet", "name": "Result bullet", "settings": [ { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "max_blocks": 5,
  "presets": [ { "name": "Home • Split hero" } ]
}
{% endschema %}
