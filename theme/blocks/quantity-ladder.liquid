{%- comment -%}
  Quantity ladder. Tier structure is baked; every price below is read live from
  all_products, so a reprice cannot leave a stale number here.

  The option axis is NOT always called "Scent" — toothpaste uses "Flavor" — so
  the option name is read off each product rather than assumed.
{%- endcomment -%}

{%- assign base_product = all_products[ladder_base] -%}
{%- assign base_unit_price = base_product.price -%}

{%- comment -%}
  "Best value" goes on the tier with the LOWEST per-unit price, which is the
  biggest pack on every configured ladder (and its default). That keeps the
  nudge true by arithmetic. Ties go to the later, bigger tier. Only shown when
  at least two tiers are available, since a lone card has nothing to beat.
{%- endcomment -%}
{%- assign best_handle = '' -%}
{%- assign best_per_unit = 0 -%}
{%- assign available_tiers = 0 -%}
{%- for handle in ladder_handles -%}
  {%- assign p = all_products[handle] -%}
  {%- if p == blank or p.available == false -%}{%- continue -%}{%- endif -%}
  {%- assign available_tiers = available_tiers | plus: 1 -%}
  {%- assign units = ladder_units[forloop.index0] | plus: 0 -%}
  {%- assign per_unit = p.price | divided_by: units -%}
  {%- if best_handle == '' or per_unit <= best_per_unit -%}
    {%- assign best_handle = handle -%}
    {%- assign best_per_unit = per_unit -%}
  {%- endif -%}
{%- endfor -%}

<div class="qty-ladder" data-qty-ladder>
  <div class="qty-ladder__heading">Choose your pack</div>
  <div class="qty-ladder__tiers" role="radiogroup" aria-label="Choose your pack size">
    {%- for handle in ladder_handles -%}
      {%- assign p = all_products[handle] -%}
      {%- assign units = ladder_units[forloop.index0] | plus: 0 -%}
      {%- assign supply = ladder_supply[forloop.index0] -%}
      {%- if p == blank or p.available == false -%}{%- continue -%}{%- endif -%}

      {%- assign per_unit = p.price | divided_by: units -%}

      {%- comment -%}
        Guard against a nil/zero base price (base product missing from
        all_products): `divided_by`/`modulo` against 0 would print a visible
        "Liquid error: divided by 0" on a live PDP. paid_remainder defaults to
        a non-zero value so the free-unit branch below can never fire on a
        base_unit_price of 0/nil -- the same guard freeUnitFraming applies in
        lib/quantity-ladder.js.
      {%- endcomment -%}
      {%- assign paid_exact = 0 -%}
      {%- assign paid_remainder = 1 -%}
      {%- assign singly = 0 -%}
      {%- if base_unit_price and base_unit_price > 0 -%}
        {%- assign paid_exact = p.price | divided_by: base_unit_price -%}
        {%- assign paid_remainder = p.price | modulo: base_unit_price -%}
        {%- assign singly = base_unit_price | times: units -%}
      {%- endif -%}

      {%- comment -%}
        The struck-through figure is what the same units cost bought one at a
        time TODAY (live single price x units), never an invented "was" price.
        A compare_at_price set on the pack wins only when it is higher.
      {%- endcomment -%}
      {%- assign compare = singly -%}
      {%- if p.compare_at_price > compare -%}{%- assign compare = p.compare_at_price -%}{%- endif -%}
      {%- assign save_pct = 0 -%}
      {%- if compare > p.price -%}
        {%- assign save_pct = compare | minus: p.price | times: 100 | divided_by: compare -%}
      {%- endif -%}

      {%- if ladder_unit_noun == 'unit' -%}
        {%- if units == 1 -%}{%- assign qty_label = 'Single' -%}{%- else -%}{%- assign qty_label = units | append: '-pack' -%}{%- endif -%}
        {%- assign cta_label = 'Add to cart' -%}
      {%- else -%}
        {%- assign qty_label = units | append: ' ' | append: ladder_unit_noun -%}
        {%- if units > 1 -%}{%- assign qty_label = qty_label | append: 's' -%}{%- endif -%}
        {%- assign cta_label = 'Add ' | append: qty_label | append: ' to cart' -%}
      {%- endif -%}

      <label class="qty-ladder__tier{% if handle == ladder_default %} is-selected{% endif %}"
             data-qty-label="{{ qty_label | escape }}" data-qty-cta-label="{{ cta_label | escape }}">
        <input type="radio" name="qty-tier" value="{{ handle }}"
               {% if handle == ladder_default %}checked{% endif %}>
        <span class="qty-ladder__radio" aria-hidden="true"></span>
        {%- comment -%} A pack with no image of its own shows the single's photo. {%- endcomment -%}
        {%- assign thumb = p.featured_image | default: base_product.featured_image -%}
        {%- if thumb -%}
          <img class="qty-ladder__thumb" src="{{ thumb | image_url: width: 160 }}"
               alt="" width="56" height="56" loading="lazy">
        {%- endif -%}
        <span class="qty-ladder__body">
          <span class="qty-ladder__head">
            <span class="qty-ladder__qty">{{ qty_label }}</span>
            {%- if handle == best_handle and available_tiers > 1 -%}
              <span class="qty-ladder__badge">Best value</span>
            {%- endif -%}
          </span>
          {%- comment -%}
            Free-unit framing only when the price divides into whole single
            units ("buy 3.5, get 0.5 free" is what the naive version prints);
            otherwise the plain percentage saved.
          {%- endcomment -%}
          {%- assign offer = '' -%}
          {%- if paid_remainder == 0 and paid_exact > 0 and paid_exact < units -%}
            {%- assign free_units = units | minus: paid_exact -%}
            {%- assign offer = 'Buy ' | append: paid_exact | append: ', get ' | append: free_units | append: ' free' -%}
          {%- elsif save_pct > 0 -%}
            {%- assign offer = 'Save ' | append: save_pct | append: '%' -%}
          {%- endif -%}
          {%- if supply != blank or offer != '' -%}
            <span class="qty-ladder__sub">
              {%- if supply != blank -%}{{ supply }}{%- endif -%}
              {%- if supply != blank and offer != '' %} · {% endif -%}
              {%- if offer != '' -%}<strong>{{ offer }}</strong>{%- endif -%}
            </span>
          {%- endif -%}
        </span>
        <span class="qty-ladder__pricing">
          <span class="qty-ladder__price-line">
            {%- if compare > p.price -%}<s class="qty-ladder__compare">{{ compare | money }}</s> {% endif -%}
            <span class="qty-ladder__price">{{ p.price | money }}</span>
          </span>
          {%- if units > 1 -%}
            <span class="qty-ladder__unit">{{ per_unit | money }}/{% if ladder_unit_noun == 'unit' %}each{% else %}{{ ladder_unit_noun }}{% endif %}</span>
          {%- endif -%}
        </span>
      </label>
    {%- endfor -%}
  </div>

  <div class="qty-ladder__options" data-qty-options></div>

  {%- comment -%}
    Statically disabled: the default tier's radio only carries `checked` when
    that tier survived the availability filter above, so a sold-out default
    would otherwise leave this button in its static enabled markup with no
    radio checked and no JS path that re-visits it until a selection changes.
    The IIFE's own renderOptions()/syncCta() correct this to the real state
    once it runs.
  {%- endcomment -%}
  <button type="button" class="qty-ladder__cta button button--full-width" data-qty-cta disabled>
    <span>Add to cart</span>
  </button>
  <p class="qty-ladder__error" data-qty-error hidden></p>
  {%- comment -%}
    Measured, not promised: 87% of the 134 orders fulfilled 2026-04-09 to
    2026-10-06 left within 48 hours (median 17h, 98% within 72h).
  {%- endcomment -%}
  <p class="qty-ladder__ships">
    <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>
    Ships in 1–2 business days
  </p>

  {%- comment -%}
    Sticky buy bar. The theme's own `sticky_cart` block CANNOT be used on a
    ladder template: it renders `{% form 'product', product %}` against the
    PAGE's product, which is always the single-unit SKU, while a ladder tier
    is a DIFFERENT product (coconut-oil-toothpaste vs
    coconut-toothpaste-3-pack). A shopper who picked the 3-pack and then used
    that bar would silently be sold one tube. Hence this bar, which shares
    selectedVariant() and addToCart() with the main CTA rather than building a
    form of its own -- there is one selection and one add path, so the two
    buttons cannot disagree.

    Starts `hidden`, so with no JS (or no IntersectionObserver) it never
    appears and the page degrades to exactly its current behaviour.

    Prices are NOT baked here: they are read out of the rendered tier card,
    which Liquid already filled from all_products. Same rule as the rest of
    this block -- a reprice must never leave a stale number on the page.
  {%- endcomment -%}
  <div class="qty-ladder-sticky" data-qty-sticky hidden>
    <div class="qty-ladder-sticky__inner">
      <div class="qty-ladder-sticky__meta">
        <span class="qty-ladder-sticky__title">{{ base_product.title | truncate: 46 }}</span>
        <span class="qty-ladder-sticky__line">
          <span class="qty-ladder-sticky__tier" data-qty-sticky-tier></span>
          <span class="qty-ladder-sticky__price" data-qty-sticky-price></span>
        </span>
      </div>
      <button type="button" class="qty-ladder-sticky__cta button" data-qty-sticky-cta disabled>
        <span>Add to cart</span>
      </button>
    </div>
  </div>

  {%- comment -%}
    Variant data per tier, for the option selector. Commas are emitted BEFORE
    each entry (guarded by a printed-flag, not `forloop.last`), because the
    outer loop skips handles missing from all_products -- `unless
    forloop.last` would leave a trailing comma with nothing after it whenever
    the LAST handle is the one that's absent (the default tier is always last
    in all three configured ladders), producing `{"a":{...},}` that
    JSON.parse throws on, aborting the whole IIFE before any listener attaches.
  {%- endcomment -%}
  <script type="application/json" data-qty-data>
    {
      {%- assign tier_printed = false -%}
      {%- for handle in ladder_handles -%}
        {%- assign p = all_products[handle] -%}
        {%- if p != blank -%}
        {%- if tier_printed -%},{%- endif -%}
        "{{ handle }}": {
          "optionName": {{ p.options.first | json }},
          "variants": [
            {%- assign variant_printed = false -%}
            {%- for v in p.variants -%}
              {%- if variant_printed -%},{%- endif -%}
              {"id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available }}}
              {%- assign variant_printed = true -%}
            {%- endfor -%}
          ]
        }
        {%- assign tier_printed = true -%}
        {%- endif -%}
      {%- endfor -%}
    }
  </script>
</div>

<style>
  .qty-ladder__heading{font-weight:700;margin:16px 0 8px}
  .qty-ladder__tiers{display:grid;gap:10px;margin:0 0 12px}
  {%- comment -%}
    Four columns: radio, thumbnail, body (quantity + badge over the supply /
    offer line), pricing (struck "buy separately" figure + price over the
    per-unit price). The native radio stays in the DOM for keyboard and
    screen-reader use, visually replaced by .qty-ladder__radio.
  {%- endcomment -%}
  .qty-ladder__tier{position:relative;display:grid;grid-template-columns:auto auto 1fr auto;gap:12px;align-items:center;
    border:1px dashed #d4d2cc;border-radius:10px;padding:12px 14px;cursor:pointer;background:#fff}
  .qty-ladder__tier.is-selected{border:2px solid #111;padding:11px 13px;background:#fafaf8}
  .qty-ladder__tier:focus-within{outline:2px solid #111;outline-offset:2px}
  .qty-ladder__tier input[type="radio"]{position:absolute;opacity:0;width:1px;height:1px;margin:0}
  .qty-ladder__radio{width:22px;height:22px;border-radius:50%;border:2px solid #b5b3ad;box-sizing:border-box;flex:0 0 auto}
  .qty-ladder__tier.is-selected .qty-ladder__radio{border:7px solid #111}
  .qty-ladder__thumb{width:56px;height:56px;object-fit:cover;border-radius:8px;background:#f4f4f2}
  .qty-ladder__body{display:flex;flex-direction:column;gap:3px;min-width:0}
  .qty-ladder__head{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
  .qty-ladder__qty{font-weight:700;font-size:1.05em}
  .qty-ladder__badge{white-space:nowrap;background:#111;color:#fff;border-radius:5px;
    padding:3px 8px;font-size:.72em;font-weight:700;letter-spacing:.02em}
  .qty-ladder__sub{font-size:.85em;color:#6d7175}
  .qty-ladder__sub strong{color:#111;font-weight:700;white-space:nowrap}
  .qty-ladder__pricing{display:flex;flex-direction:column;align-items:flex-end;gap:3px;text-align:right}
  .qty-ladder__price-line{white-space:nowrap}
  .qty-ladder__compare{color:#8a8d91;font-size:.85em;margin-right:4px}
  .qty-ladder__price{font-variant-numeric:tabular-nums;font-weight:700;font-size:1.1em}
  .qty-ladder__unit{font-size:.8em;color:#6d7175;white-space:nowrap}
  .qty-ladder__ships{display:flex;align-items:center;justify-content:center;gap:8px;
    font-size:.9em;color:#3d4043;margin:10px 0 0}
  @media screen and (max-width:420px){
    .qty-ladder__tier{gap:10px;padding:10px 12px}
    .qty-ladder__tier.is-selected{padding:9px 11px}
    .qty-ladder__thumb{width:44px;height:44px}
  }
  {%- comment -%}
    .qty-ladder__cta deliberately carries NO sizing/color rules -- it is a
    hook for the JS selector and for the theme's own
    `button button--full-width` classes (filled primary), which supply
    size, color, hover/focus and [disabled] styling. Spacing above the CTA
    is set on the injected <select> itself (see the IIFE below), not here.
  {%- endcomment -%}
  .qty-ladder__error{color:#b3261e;font-size:.9em;margin:8px 0 0}

  /* Sticky buy bar. [hidden] is a class+attribute selector, so it outranks the
     display:flex above and the attribute alone is enough to hide the bar --
     no JS style writing, and no chance of the bar being stranded visible if
     the observer never runs. */
  .qty-ladder-sticky{position:fixed;left:0;right:0;bottom:0;z-index:40;background:#fff;
    border-top:1px solid #e0ded8;box-shadow:0 -2px 12px rgba(0,0,0,.08);
    padding:10px 16px calc(10px + env(safe-area-inset-bottom))}
  .qty-ladder-sticky[hidden]{display:none}
  .qty-ladder-sticky__inner{display:flex;align-items:center;gap:16px;
    max-width:1200px;margin:0 auto}
  .qty-ladder-sticky__meta{display:flex;flex-direction:column;min-width:0;flex:1 1 auto}
  .qty-ladder-sticky__title{font-size:.85em;color:#5c5f5a;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis}
  .qty-ladder-sticky__line{display:flex;align-items:baseline;gap:8px;white-space:nowrap}
  .qty-ladder-sticky__tier{font-weight:600}
  .qty-ladder-sticky__price{font-weight:600}
  .qty-ladder-sticky__cta{flex:0 0 auto;width:auto;margin:0}
  /* Below 750px the product title is the first thing to go: the tier, the
     price and the button are the only parts that carry a decision. */
  @media screen and (max-width:749px){
    .qty-ladder-sticky__title{display:none}
    .qty-ladder-sticky__inner{gap:12px}
    .qty-ladder-sticky__cta{padding-left:18px;padding-right:18px}
  }
</style>

<script>
(function () {
  var root = document.querySelector('[data-qty-ladder]');
  if (!root) return;
  var data = JSON.parse(root.querySelector('[data-qty-data]').textContent);
  var optionsEl = root.querySelector('[data-qty-options]');
  var cta = root.querySelector('[data-qty-cta]');
  // The button's label lives in a child <span>, matching the theme's own
  // product-form button markup -- cta.textContent would blow away that
  // <span> (and any future theme-injected content) instead of just
  // updating the visible label.
  var ctaLabel = cta.querySelector('span');
  var errorEl = root.querySelector('[data-qty-error]');
  var chosenOption = null;

  // Sticky bar. Every one of these may be absent on a template built before
  // the bar existed, so each use is guarded -- a missing bar must degrade to
  // the pre-existing single-CTA behaviour, never throw and take the whole
  // IIFE (and with it the main Add to cart) down with it.
  var sticky = root.querySelector('[data-qty-sticky]');
  var stickyCta = sticky && sticky.querySelector('[data-qty-sticky-cta]');
  var stickyCtaLabel = stickyCta && stickyCta.querySelector('span');
  var stickyTier = sticky && sticky.querySelector('[data-qty-sticky-tier]');
  var stickyPrice = sticky && sticky.querySelector('[data-qty-sticky-price]');

  // Display-only label transform: the tier card already says "12-pack" /
  // "4-pack", so repeating the count in the option text is redundant. Strips
  // a leading "<digits>x " count prefix and collapses "Variety — <anything>"
  // to plain "Variety". opt.value (the variant id posted to /cart/add.js) is
  // never touched by this -- see the call site below. An unrecognised shape
  // (no count prefix, not a Variety title) passes through UNCHANGED, never
  // blanked, so a future option naming scheme degrades to its raw title
  // instead of an empty label.
  function ladderOptionLabel(title) {
    if (typeof title !== 'string') return title;
    if (/^Variety\s*[—-]\s*.+/i.test(title)) return 'Variety';
    return title.replace(/^\d+x\s+/i, '');
  }

  function currentTier() {
    var checked = root.querySelector('input[name="qty-tier"]:checked');
    return checked ? checked.value : null;
  }

  function renderOptions() {
    var tier = currentTier();
    var info = data[tier];
    optionsEl.innerHTML = '';
    if (!info) { syncCta(); return; }

    var label = document.createElement('label');
    label.textContent = info.optionName;
    label.style.cssText = 'display:block;font-size:.9em;margin:10px 0 4px';
    var select = document.createElement('select');
    // margin-bottom is the gap between the scent/flavor select and the CTA
    // button below it -- without it they render touching, since neither
    // .qty-ladder__options nor the theme's button classes supply any
    // separation on their own.
    select.style.cssText = 'width:100%;padding:10px;border:1px solid #e0ded8;border-radius:6px;margin-bottom:14px';

    info.variants.forEach(function (v) {
      var opt = document.createElement('option');
      opt.value = v.id;
      opt.textContent = ladderOptionLabel(v.title) + (v.available ? '' : ' — sold out');
      opt.disabled = !v.available;
      // Keep the shopper's choice across a tier change when the new tier offers
      // it; otherwise fall back to the first available option. Compared on the
      // DISPLAY label (same transform), since that's what chosenOption stores.
      if (chosenOption && ladderOptionLabel(v.title) === chosenOption) opt.selected = true;
      select.appendChild(opt);
    });

    select.addEventListener('change', function () {
      chosenOption = select.options[select.selectedIndex].textContent.replace(' — sold out', '');
      syncCta();
    });
    optionsEl.appendChild(label);
    optionsEl.appendChild(select);
    syncCta();
  }

  function selectedVariant() {
    var select = optionsEl.querySelector('select');
    if (!select) return null;
    var info = data[currentTier()];
    return info.variants.find(function (v) { return String(v.id) === select.value; }) || null;
  }

  function syncCta() {
    var v = selectedVariant();
    var soldOut = !!v && !v.available;
    // Tier name and price are read out of the rendered tier card, so neither
    // button can show a price Liquid did not print (no baked prices here).
    var checked = root.querySelector('input[name="qty-tier"]:checked');
    var card = checked && checked.closest('.qty-ladder__tier');
    var priceEl = card && card.querySelector('.qty-ladder__price');
    var price = priceEl ? priceEl.textContent.trim() : '';
    var base = (card && card.getAttribute('data-qty-cta-label')) || 'Add to cart';
    var label = soldOut ? 'Sold out' : (price ? base + ' · ' + price : base);
    cta.disabled = !v || soldOut;
    ctaLabel.textContent = label;

    // The sticky bar mirrors the SAME selection rather than tracking its own.
    if (!sticky) return;
    stickyCta.disabled = cta.disabled;
    stickyCtaLabel.textContent = soldOut ? 'Sold out' : 'Add to cart';
    stickyTier.textContent = (card && card.getAttribute('data-qty-label')) || '';
    stickyPrice.textContent = price;
  }

  root.querySelectorAll('input[name="qty-tier"]').forEach(function (input) {
    input.addEventListener('change', function () {
      root.querySelectorAll('.qty-ladder__tier').forEach(function (el) {
        el.classList.toggle('is-selected', el.contains(input) && input.checked);
      });
      renderOptions();
    });
  });

  // ONE add path for both buttons. The sticky bar deliberately does not build
  // a <form> of its own -- that is precisely what makes the theme's stock
  // sticky_cart wrong here (it posts the page's product, not the chosen tier).
  // The theme's cart drawer element is <mini-cart> (defined in
  // assets/cart-drawer.js, NOT <cart-drawer>, which is its outer shell).
  // assets/product-form.js drives it with a three-step handshake, and this
  // reuses that rather than toggling classes: ask for the drawer's own
  // sections on the add, hand the response to renderContents(), and let it
  // call open(). That way the drawer's line items, subtotal and BOTH icon
  // bubbles are re-rendered by the theme's own code, which is what keeps this
  // block working when the drawer markup changes.
  //
  // Feature-detected rather than assumed: a theme without the drawer (or with
  // a renamed element) must fall back, not throw.
  function cartDrawer() {
    var el = document.querySelector('mini-cart');
    if (!el) return null;
    return typeof el.getSectionsToRender === 'function'
      && typeof el.renderContents === 'function' ? el : null;
  }

  function addToCart(evt) {
    var v = selectedVariant();
    if (!v) return;
    errorEl.hidden = true;
    cta.disabled = true;
    if (sticky) stickyCta.disabled = true;

    // Bundled section rendering: /cart/add.js returns the rendered HTML for
    // the requested sections under `sections`, keyed by the ids we pass.
    var drawer = cartDrawer();
    var payload = { items: [{ id: v.id, quantity: 1 }] };
    if (drawer) {
      payload.sections = drawer.getSectionsToRender().map(function (s) { return s.id; }).join(',');
      payload.sections_url = window.location.pathname;
      // Focus returns here when the drawer closes, same as the theme's forms.
      if (typeof drawer.setActiveElement === 'function' && evt && evt.currentTarget) {
        drawer.setActiveElement(evt.currentTarget);
      }
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (r) { if (!r.ok) throw new Error('Could not add to cart'); return r.json(); })
      .then(function (state) {
        // Past this point the item IS in the cart. So every failure here falls
        // back to the cart PAGE and none of them may surface an error --
        // telling a shopper the add failed when it succeeded is how you get a
        // double order. Covers: no drawer element, a response without
        // `sections`, and renderContents() throwing (its open() dereferences
        // the <cart-drawer> shell, which a template could be missing).
        if (!drawer || !state || !state.sections) { window.location.href = '/cart'; return; }
        try {
          drawer.renderContents(state);
        } catch (e) {
          window.location.href = '/cart';
          return;
        }
        // Staying on the page, so both buttons have to come back.
        syncCta();
      })
      .catch(function (err) {
        errorEl.textContent = err.message + '. Please try again.';
        errorEl.hidden = false;
        // syncCta re-derives BOTH buttons from the current selection, so a
        // failed add cannot leave one of them stuck disabled.
        syncCta();
      });
  }

  cta.addEventListener('click', addToCart);

  if (sticky) {
    stickyCta.addEventListener('click', addToCart);

    // Reveal the bar only once the main CTA has scrolled ABOVE the viewport.
    // `!isIntersecting` alone is not enough: it is also false on load, while
    // the CTA is still below the fold, which would show the bar over the hero
    // before the shopper has seen the ladder at all. boundingClientRect.top
    // is what distinguishes "scrolled past" from "not yet reached".
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          sticky.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0;
        });
      }, { threshold: 0 }).observe(cta);
    }
  }

  renderOptions();
})();
</script>

<noscript>
  {%- comment -%} Without JS the default tier is still buyable. {%- endcomment -%}
  {%- assign default_product = all_products[ladder_default] -%}
  {%- form 'product', default_product -%}
    <input type="hidden" name="id" value="{{ default_product.selected_or_first_available_variant.id }}">
    <button type="submit" class="qty-ladder__cta button button--full-width">
      <span>Add {{ default_product.title }} to cart</span>
    </button>
  {%- endform -%}
</noscript>
