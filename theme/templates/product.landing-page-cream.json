        },
        "ingredient-card-2": {
          "type": "column",
          "settings": {
            "background_color": "#f2f2f2",
            "heading_color": "#000000",
            "text_color": "#333333",
            "image": "shopify:\/\/shop_images\/Coconut_Oil_Extract.webp",
            "title": "Organic Virgin Coconut Oil",
            "title_size": "medium",
            "text": "<p><em>Fatty-acid nourishment.<\/em> Cold-pressed virgin coconut oil keeps its full lauric acid content — roughly 50% of its fatty acid profile. The medium-chain fatty acids absorb into the skin barrier rather than sitting on top. Refined coconut oil is cheaper and uniform batch-to-batch because the lab strips the variation out, along with most of the lauric acid.<\/p>",
            "show_popup": false,
            "popup_image_position": "top",
            "justify_text": false,
            "button_label": "",
            "button_link": "",
            "button_style_secondary": false,
            "enable_highlight": false,
