    "hero-ingredient-cards": {
      "type": "multicolumn",
      "blocks": {
        "ingredient-card-1": {
          "type": "column",
          "settings": {
            "background_color": "#f2f2f2",
            "heading_color": "#000000",
            "text_color": "#333333",
            "image": "shopify:\/\/shop_images\/Wax.webp",
            "title": "Organic Beeswax",
            "title_size": "medium",
            "text": "<p><em>Moisture-lock barrier.<\/em> Beeswax forms a breathable barrier that locks moisture in without sealing pores the way petrolatum does. Its long-chain fatty acids and esters create a flexible film that holds skin's own water content while still allowing gas exchange. Petrolatum is cheaper and shelf-stable forever — it also fully occludes. We pay more for beeswax.<\/p>",
            "show_popup": false,
            "popup_image_position": "top",
            "justify_text": false,
            "button_label": "",
            "button_link": "",
