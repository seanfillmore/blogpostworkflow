      "block_order": [
        "fc-heading",
        "fc-text",
        "fc-button"
      ],
      "settings": {
        "text_alignment": "center",
        "mobile_text_alignment": "center",
        "horizontal_content": false,
        "narrow": false,
        "show_divider": false,
        "use_custom_colors": true,
        "colors_button_label": "#1a1b18",
