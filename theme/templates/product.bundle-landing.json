        "value-stack": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>.crx-vs{border:1px solid #cbd8c0;background:#f4f8ee;border-radius:12px;padding:18px 20px 16px;margin:18px 0;}.crx-vs *{box-sizing:border-box;}.crx-vs__title{font-weight:700;font-size:15px;color:#1a1b18;margin:0 0 12px;letter-spacing:-0.01em;font-family:inherit;}.crx-vs__row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:8px 0;border-bottom:1px solid #e2ead9;}.crx-vs__row:last-of-type{border-bottom:0;}.crx-vs__label{font-size:14.5px;color:#33352f;line-height:1.35;font-family:inherit;}.crx-vs__scent{display:block;color:#6d7f63;font-size:12.5px;margin-top:1px;}.crx-vs__label small{color:#7c8a72;font-size:12.5px;}.crx-vs__price{font-size:14.5px;font-weight:600;color:#1a1b18;white-space:nowrap;}.crx-vs__total{display:flex;justify-content:space-between;align-items:baseline;margin-top:12px;padding-top:12px;border-top:2px solid #cbd8c0;}.crx-vs__tl{font-weight:700;font-size:16px;color:#1a1b18;}.crx-vs__was{color:#9aa593;text-decoration:line-through;font-weight:500;margin-right:8px;font-size:15px;}.crx-vs__now{color:#4a8b3c;font-weight:700;font-size:17px;}.crx-vs__save{margin-top:12px;background:#4a8b3c;color:#fff;text-align:center;font-weight:700;font-size:14px;letter-spacing:0.3px;padding:9px 12px;border-radius:8px;}.crx-vs__note{margin:10px 0 0;font-size:12.5px;color:#6d7175;line-height:1.45;}.crx-vs__incl{margin-top:12px;padding-top:12px;border-top:1px dashed #cbd8c0;}.crx-vs__incl-t{margin:0 0 6px;font-size:12.5px;font-weight:700;color:#4a8b3c;letter-spacing:.02em;}.crx-vs__incl-r{font-size:13.5px;color:#4a4a4a;line-height:1.5;}.crx-vs__incl-r:before{content:\"+ \";color:#4a8b3c;font-weight:700;}<\/style>{%- assign has_stack = false -%}{%- for v in product.variants -%}{% if v.metafields.bundle.value_stack.value %}{% assign has_stack = true %}{% endif %}{%- endfor -%}{%- if has_stack -%}{%- for v in product.variants -%}{%- assign stack = v.metafields.bundle.value_stack.value -%}{%- if stack and stack.size > 0 -%}{%- liquid\n  assign total = 0\n  assign has_digital = false\n  for row in stack\n    if row.digital\n      assign has_digital = true\n    else\n      assign total = total | plus: row.amount\n    endif\n  endfor\n  assign price_dollars = v.price | divided_by: 100\n  assign savings = total | minus: price_dollars\n-%}<div class=\"crx-vs\" data-vs-variant=\"{{ v.id }}\"{% unless v == product.selected_or_first_available_variant %} style=\"display:none\"{% endunless %}><p class=\"crx-vs__title\">{% if product.variants.size > 1 %}Everything in your {{ v.title }} box{% else %}Everything in your box{% endif %}<\/p>{%- for row in stack -%}{%- unless row.digital -%}<div class=\"crx-vs__row\"><span class=\"crx-vs__label\">{% if row.qty and row.qty > 1 %}{{ row.qty }} &times; {% endif %}{{ row.label }}{% if row.digital %} <small>(digital)<\/small>{% endif %}{% if row.scent %}<span class=\"crx-vs__scent\">{{ row.scent }}<\/span>{% endif %}<\/span><span class=\"crx-vs__price\">${{ row.amount }}<\/span><\/div>{%- endunless -%}{%- endfor -%}{%- if has_digital -%}<div class=\"crx-vs__incl\"><p class=\"crx-vs__incl-t\">Also included, free<\/p>{%- for row in stack -%}{%- if row.digital -%}<div class=\"crx-vs__incl-r\">{{ row.label }}<\/div>{%- endif -%}{%- endfor -%}<\/div>{%- endif -%}<div class=\"crx-vs__total\"><span class=\"crx-vs__tl\">Total value<\/span><span><span class=\"crx-vs__was\">${{ total }}<\/span><span class=\"crx-vs__now\">{{ v.price | money }} today<\/span><\/span><\/div><div class=\"crx-vs__save\">You save ${{ savings }} today<\/div>{%- if product.variants.size > 1 -%}<p class=\"crx-vs__note\">Want different scents? Add a note below and we'll swap them.<\/p>{%- endif -%}<\/div>{%- endif -%}{%- endfor -%}<script>(function(){\n  var sel = document.getElementById('vqr-variant-{{ product.id }}');\n  if(!sel) return;\n  sel.addEventListener('change', function(){\n    document.querySelectorAll('[data-vs-variant]').forEach(function(el){\n      el.style.display = (el.getAttribute('data-vs-variant') === sel.value) ? '' : 'none';\n    });\n  });\n})();<\/script>{%- endif -%}"
          }
        },
        "bundle-savings": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign stack = product.metafields.bundle.value_stack.value\n  assign days = product.metafields.bundle.duration_days.value\n  assign total = 0\n  for row in stack\n    unless row.digital\n      assign total = total | plus: row.amount\n    endunless\n  endfor\n  assign price_dollars = product.price | divided_by: 100\n  assign savings = total | minus: price_dollars\n-%}\n<div style=\"margin:8px 0 4px 0;font-size:1em;font-weight:700;color:#4a8b3c;line-height:1.35;\">${{ total }} of value &mdash; yours today for {{ product.price | money }}<\/div>\n<div style=\"font-size:0.85em;color:#6d7175;margin:4px 0 12px 0;line-height:1.45;\">That&rsquo;s <strong>${{ savings }} in savings<\/strong>{% if days %} for a full {{ days }}-day routine &mdash; about {{ product.price | divided_by: days | money }} a day{% endif %}.<\/div>"
          }
        },
        "trust-row": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>.lander-trust-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:18px 0 4px 0;border-top:1px solid #e5e5e5;margin-top:18px}.lander-trust-row__item{display:flex;gap:10px;align-items:center;justify-content:center;text-align:center}.lander-trust-row__icon{font-size:1.4em;line-height:1;flex-shrink:0}.lander-trust-row__title{font-weight:700;font-size:0.9em;line-height:1.3;color:#1a1b18}@media(max-width:600px){.lander-trust-row{grid-template-columns:1fr;gap:10px}}<\/style><div class=\"lander-trust-row\"><div class=\"lander-trust-row__item\"><span class=\"lander-trust-row__icon\">🛡️<\/span><div class=\"lander-trust-row__title\">30-Day Money-Back Guarantee<\/div><\/div><div class=\"lander-trust-row__item\"><span class=\"lander-trust-row__icon\">📦<\/span><div class=\"lander-trust-row__title\">Shipped in 2 Business Days<\/div><\/div><div class=\"lander-trust-row__item\"><span class=\"lander-trust-row__icon\">🌱<\/span><div class=\"lander-trust-row__title\">Certified Organic Ingredients<\/div><\/div><\/div>"
          }
        },
        "scent-request": {
          "type": "line_item_property",
          "settings": {
            "type": "text",
            "label": "Prefer different scents? Tell us here (optional)",
            "required": false
          }
        },
        "benefits": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.bb__list{list-style:none;margin:14px 0 4px;padding:0}\n.bb__item{display:flex;gap:10px;align-items:flex-start;padding:5px 0;font-size:15px;line-height:1.45;color:#1a1b18}\n.bb__tick{flex:0 0 20px;height:20px;border:1.5px solid #7da86a;border-radius:4px;display:flex;align-items:center;justify-content:center;margin-top:1px}\n.bb__tick svg{width:12px;height:12px;stroke:#4a8b3c;stroke-width:2.5;fill:none}\n<\/style>\n{%- liquid\n  assign lander = product.metafields.bundle.lander.value\n  assign lines = lander.buybox_bullets.value\n  assign stack = product.metafields.bundle.value_stack.value\n  assign total = 0\n  for row in stack\n    unless row.digital\n      assign total = total | plus: row.amount\n    endunless\n  endfor\n  assign price_dollars = product.price | divided_by: 100\n  assign savings = total | minus: price_dollars\n-%}\n{%- if lines != blank and lines.size > 0 -%}\n<ul class=\"bb__list\">\n  {%- for l in lines -%}\n  <li class=\"bb__item\">\n    <span class=\"bb__tick\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"\/><\/svg><\/span>\n    <span>{{ l | replace: '[[TOTAL]]', total | replace: '[[PRICE]]', price_dollars | replace: '[[SAVINGS]]', savings }}<\/span>\n  <\/li>\n  {%- endfor -%}\n<\/ul>\n{%- endif -%}"
          }
        },
        "tabs": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.bt{margin:20px 0 8px;border-top:1px solid #e3e3e3}\n.bt__item{border-bottom:1px solid #e3e3e3}\n.bt__item summary{list-style:none;cursor:pointer;padding:14px 2px;font-weight:600;font-size:15px;color:#1a1b18;display:flex;justify-content:space-between;align-items:center}\n.bt__item summary::-webkit-details-marker{display:none}\n.bt__item summary:after{content:\"+\";font-weight:400;font-size:20px;color:#6d7175}\n.bt__item[open] summary:after{content:\"\\2212\"}\n.bt__body{padding:0 2px 16px;font-size:14.5px;line-height:1.6;color:#4a4a4a}\n<\/style>\n{%- assign tabs = product.metafields.bundle.lander.value.tabs.value -%}\n{%- if tabs != blank and tabs.size > 0 -%}\n<div class=\"bt\">\n  {%- for t in tabs -%}\n  <details class=\"bt__item\"><summary>{{ t.heading }}<\/summary><div class=\"bt__body\">{{ t.body }}<\/div><\/details>\n  {%- endfor -%}\n<\/div>\n{%- endif -%}"
          }
        }
