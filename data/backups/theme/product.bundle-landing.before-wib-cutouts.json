    "free-from-block": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>.free-from-band{background:#eef3e8;padding:72px 0;text-align:center;margin-left:calc(-50vw + 50%);margin-right:calc(-50vw + 50%);width:100vw}.free-from-band__inner{max-width:1180px;margin:0 auto;padding:0 32px}.free-from-band__heading{font-size:clamp(2rem,4vw,3.25rem);line-height:1.05;font-weight:700;color:#1a1b18;margin:0 0 48px 0;letter-spacing:-0.01em}.free-from-band__list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px 32px;list-style:none;padding:0;margin:0;max-width:1100px;margin-left:auto;margin-right:auto}.free-from-band__list li{display:flex;align-items:center;justify-content:flex-start;gap:14px;font-size:1.2rem;line-height:1.25;font-weight:600;color:#1a1b18;text-align:left}.free-from-band__list li::before{content:\"✗\";color:#4a8b3c;font-size:1.7em;font-weight:800;line-height:1;flex-shrink:0}@media(max-width:900px){.free-from-band__list{grid-template-columns:repeat(2,1fr);gap:18px 24px;max-width:520px}}@media(max-width:480px){.free-from-band__list{grid-template-columns:1fr;gap:14px;max-width:280px}.free-from-band{padding:48px 0}.free-from-band__heading{font-size:1.625rem;margin-bottom:32px}}<\/style><div class=\"free-from-band\"><div class=\"free-from-band__inner\"><h2 class=\"free-from-band__heading\">What's NOT in any bottle or jar<\/h2><ul class=\"free-from-band__list\"><li>Mineral oil<\/li><li>Petrolatum<\/li><li>Dimethicone<\/li><li>Lanolin<\/li><li>Parabens<\/li><li>Phenoxyethanol<\/li><li>Synthetic fragrance<\/li><li>SLS \/ sulfates<\/li><\/ul><\/div><\/div>",
        "full_width": true,
        "show_divider": false,
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "collapsible-content": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.bfaq{max-width:760px;margin:0 auto;padding:52px 18px}\n.bfaq__h{text-align:center;font-size:clamp(22px,3vw,30px);font-weight:700;margin:0 0 22px;color:#1a1b18}\n.bfaq__item{border-bottom:1px solid #e3e3e3}\n.bfaq__item summary{list-style:none;cursor:pointer;padding:16px 2px;font-weight:600;font-size:16px;color:#1a1b18;display:flex;justify-content:space-between;gap:16px;align-items:center}\n.bfaq__item summary::-webkit-details-marker{display:none}\n.bfaq__item summary:after{content:\"+\";font-weight:400;font-size:22px;color:#6d7175}\n.bfaq__item[open] summary:after{content:\"\\2212\"}\n.bfaq__a{padding:0 2px 18px;font-size:15px;line-height:1.65;color:#4a4a4a}\n<\/style>\n{%- assign faq = product.metafields.bundle.lander.value.faq.value -%}\n{%- if faq != blank and faq.size > 0 -%}\n<div class=\"bfaq\">\n  <h2 class=\"bfaq__h\">FAQs<\/h2>\n  {%- for f in faq -%}\n  <details class=\"bfaq__item\"><summary>{{ f.q }}<\/summary><div class=\"bfaq__a\">{{ f.a }}<\/div><\/details>\n  {%- endfor -%}\n<\/div>\n{%- endif -%}"
      }
    },
