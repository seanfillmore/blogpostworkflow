{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

<style>
.rsc-article-with-sidebar{display:flex;gap:40px;align-items:flex-start}
.rsc-article-body{flex:1;min-width:0}
.rsc-article-sidebar{width:280px;flex-shrink:0}
.rsc-sidebar-heading{font-size:13px;text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin:0 0 16px;color:inherit}
.rsc-sidebar-product{margin-bottom:16px;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;background:#fff}
.rsc-sidebar-product-img-link{display:block;aspect-ratio:1/1;overflow:hidden}
.rsc-sidebar-product-img{width:100%;height:100%;object-fit:cover;display:block}
.rsc-sidebar-product-info{padding:10px 12px}
.rsc-sidebar-product-title{font-size:13px;font-weight:600;margin:0 0 4px;line-height:1.3;color:#111}
.rsc-sidebar-product-price{font-size:13px;color:#374151;margin:0 0 8px}
.rsc-sidebar-product-btn{display:inline-block;background:#AEDEAC;color:#000;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none}
.rsc-sidebar-product-btn:hover{opacity:.85}
@media(max-width:768px){.rsc-article-with-sidebar{flex-direction:column}.rsc-article-sidebar{width:100%;position:static}}
.rsc-newsletter-wrap{display:flex;align-items:center;gap:32px;background:linear-gradient(to right,rgba(254,247,240,0) 0%,rgba(254,247,240,.9) 30%,rgba(254,247,240,1) 50%,rgba(254,247,240,1) 100%),url({{ 'rsc-newsletter-banner.jpg' | asset_url }}) left center / auto 100% no-repeat #fef7f0;border-radius:10px;padding:28px 32px;margin:32px 0;overflow:hidden;border:1px solid #c8c8c8}
.rsc-newsletter-copy{flex:1;min-width:0}
.rsc-newsletter-heading{font-size:22px;font-weight:700;margin:0 0 8px;color:#111}
.rsc-newsletter-sub{font-size:15px;color:#444;margin:0}
.rsc-newsletter-form-wrap{flex:1;min-width:0}
@media(max-width:600px){.rsc-newsletter-wrap{flex-direction:column}}
.article-template__hero-adapt,.article-template__hero-medium,.article-template__hero-large{aspect-ratio:16/9;max-height:700px;padding-bottom:0!important;overflow:hidden;position:relative}
.article-template__hero-adapt img,.article-template__hero-medium img,.article-template__hero-large img{position:absolute!important;width:100%!important;height:100%!important;object-fit:cover!important;object-position:center!important;top:0!important;left:0!important}
</style>

<article class="article-template section--padding" itemscope itemtype="http://schema.org/BlogPosting">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'featured_image'-%}
        {%- if article.image -%}
          <use-animate data-animate="zoom-fade" class="article-template__hero-container media-wrapper" {{ block.shopify_attributes }}>
            <div class="article-template__hero-{{ block.settings.image_height }} image-animate media"
              itemprop="image"
              {%- if block.settings.image_height == 'adapt' %} style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"{% endif -%}
            >
              {%- capture sizes -%}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw{%- endcapture -%}
              {{ article.image | image_url: width: 3000 | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                sizes: sizes,
                widths: '375, 750, 1100, 1500, 1780, 2000, 3000',
                is: 'lazy-image'
              }}
            </div>
          </use-animate>
        {%- endif -%}

        {%- when 'breadcrumb' -%}
          <div class="page-width page-width--inner breadcrumb-wrapper center" {{ block.shopify_attributes }}>
            {% render 'breadcrumbs', text_style: block.settings.text_style, show_divider: block.settings.show_divider %}
          </div>

        {%- when 'title'-%}
          <header class="page-width page-width--inner" {{ block.shopify_attributes }}>
            <h1 class="article-template__title h0" itemprop="headline">{{ article.title | escape }}</h1>
              {%- if block.settings.blog_show_date -%}
                {%- assign pub_ts = article.published_at | date: "%s" | plus: 0 -%}
                {%- assign upd_ts = article.updated_at  | date: "%s" | plus: 0 -%}
                {%- assign delta_seconds = upd_ts | minus: pub_ts -%}
                {%- assign meaningful_threshold = 86400 -%} {% comment %}24h; adjust if you want{% endcomment %}

                <span class="circle-divider typeset2" itemprop="dateCreated pubdate datePublished">
                  Published:&nbsp;{{ article.published_at | date: "%B %-d, %Y" }}
                </span>

                {%- if upd_ts > pub_ts and delta_seconds > meaningful_threshold -%}
                  <span class="circle-divider typeset2" itemprop="dateModified">
                    Updated:&nbsp;{{ article.updated_at | date: "%B %-d, %Y" }}
                  </span>
                {%- endif -%}
              {%- endif -%}

              {%- if block.settings.blog_show_author -%}
                <span class="circle-divider typeset2" itemprop="author" itemscope itemtype="http://schema.org/Person">
                  <span itemprop="name">{{ article.author }}</span>
                </span>
              {%- endif -%}
            {%- if block.settings.blog_show_comment_count and article.comments_count > 0 and blog.comments_enabled? -%}
              <span class="circle-divider typeset2">
                <a href="#comments" class="link">{{ 'blogs.article.comments' | t: count: article.comments_count }}</a>
              </span>
            {%- endif -%}
          </header>

        {%- when 'content'-%}
          <div class="rsc-article-with-sidebar page-width page-width--inner" {{ block.shopify_attributes }}>
            <div class="rsc-article-body rte" itemprop="articleBody" id="rsc-article-body">
              {{ article.content }}
            </div>
            {%- assign sidebar_collection = collections['blog-sidebar'] -%}
            {%- if sidebar_collection != empty and sidebar_collection.products.size > 0 -%}
              <aside class="rsc-article-sidebar">
                <p class="rsc-sidebar-heading">Our Products</p>
                {%- for product in sidebar_collection.products limit: 6 -%}
                  <div class="rsc-sidebar-product">
                    {%- if product.featured_image -%}
                      <a href="{{ product.url }}" class="rsc-sidebar-product-img-link">
                        {{ product.featured_image | image_url: width: 280, height: 280, crop: 'center' | image_tag: alt: product.title, loading: 'lazy', class: 'rsc-sidebar-product-img' }}
                      </a>
                    {%- endif -%}
                    <div class="rsc-sidebar-product-info">
                      <p class="rsc-sidebar-product-title">{{ product.title }}</p>
                      <p class="rsc-sidebar-product-price">{{ product.price_min | money }}</p>
<a href="{{ product.url }}" class="rsc-sidebar-product-btn">Shop Now</a>
                    </div>
                  </div>
                {%- endfor -%}
              </aside>

            {%- endif -%}
          </div>
          <script>
            document.addEventListener('DOMContentLoaded', function() {
              var body = document.getElementById('rsc-article-body');
              if (!body) return;
              var headings = body.querySelectorAll('h2');
              var target = headings.length >= 3 ? headings[2] : (headings.length >= 2 ? headings[1] : null);
              var wrapper = document.createElement('div');
              wrapper.innerHTML = '<div class="rsc-newsletter-wrap"><div class="rsc-newsletter-copy"><p class="rsc-newsletter-heading">Newsletter Subscribe</p><p class="rsc-newsletter-sub">For more <strong>blog updates</strong> and <strong>exclusive discounts</strong></p></div><div class="rsc-newsletter-form-wrap"><div class="klaviyo-form-Xr4S7X"></div></div></div>';
              if (target) {
                target.insertAdjacentElement('beforebegin', wrapper);
              } else {
                body.appendChild(wrapper);
              }
            });
          </script>

        {%- when 'share'-%}
          <div class="article-template__social-sharing page-width page-width--inner">
            {%- liquid
              assign share_url = article.url | prepend: request.origin
              render 'share-button', block: block, share_link: share_url, share_image: article.image, share_title: article.title
            -%}
          </div>

        {%- when 'back_to_blog'-%}
          <div class="element-margin center" {{ block.shopify_attributes }}>
            <a href="{{ blog.url }}" class="article-template__link button button--tertiary animate-arrow">
              {% render 'icon', icon: 'arrow' %}
              {{ 'blogs.article.back_to_blog' | t: title: blog.title }}
            </a>
          </div>

        {%- when 'next_previous_posts'-%}
          {%- if blog.next_article or blog.previous_article -%}
            <ul class="article-template__navigation page-width element-margin" {{ block.shopify_attributes }}>
              <li class="navigation__previous">
                {%- if blog.previous_article -%}
                  <a href="{{ blog.previous_article.url }}">
                    {% render 'icon', icon: 'arrow' %}
                    <span class="h3">{{ blog.previous_article.title }}</span>
                  </a>
                {%- endif -%}
              </li>

              <li class="navigation__next">
                {%- if blog.next_article -%}
                  <a href="{{ blog.next_article.url }}">
                    <span class="h3">{{ blog.next_article.title }}</span>
                    {% render 'icon', icon: 'arrow' %}
                  </a>
                {%- endif -%}
              </li>
            </ul>
          {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}

  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper">
      <div id="comments" class="page-width page-width--inner">
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <p id="Comments-{{ article.id }}" class="h3 uppercase">{{ 'blogs.article.comments' | t: count: article.comments_count }}</p>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- liquid
                if comment.status == 'pending' and comment.content
                  render 'comment', comment: comment, show_gravatar: section.settings.show_gravatar
                endif

                for comment in article.comments
                  render 'comment', comment: comment, show_gravatar: section.settings.show_gravatar
                endfor

                render 'pagination', paginate: paginate, anchor: anchorId
              -%}
            </div>
          {% endpaginate %}
        {%- endif -%}

        <form-state class="center">
          {% form 'new_comment', article %}
            {%- liquid
              assign post_message = 'blogs.article.success'
              if blog.moderated? and comment.status == 'unapproved'
                assign post_message = 'blogs.article.success_moderated'
              endif
            -%}
            <p class="h3 uppercase">{{ 'blogs.article.comment_form_title' | t }}</p>
            {%- if blog.moderated? -%}
              <p class="article-template__comment-warning">{{ 'blogs.article.moderated' | t }}</p>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <p class="form-status-list form__message h3" role="status" tabindex="-1" autofocus>
                {% render 'icon', icon: 'success' %}
                {{ post_message | t }}
              </p>
            {%- endif -%}

            <div {% if blog.moderated? == false %}class="article-template__comments-fields"{% endif %}>
              <div class="article-template__comment-fields">
                <div class="field field--with-error">
                  <input
                    id="CommentForm-author"
                    type="text"
                    name="comment[author]"
                    class="field__input required{% if form.errors contains 'author' %} invalid{% endif %}"
                    required="required"
                    autocomplete="name"
                    value="{{ form.author }}"
                    aria-required="true"
                    placeholder="{{ 'blogs.article.name' | t }}"
                    {%- if form.errors contains 'author' %}
                      aria-invalid="true"
                      aria-describedby="CommentForm-author-error"
                    {% endif -%}
                  />
                  <label class="visually-hidden" for="CommentForm-author">{{ 'blogs.article.name' | t }}</label>
                  {%- if form.errors contains 'author' -%}
                    <small id="CommentForm-author-error">
                      <span class="form__message errors">
                        {% render 'icon', icon: 'error' %}
                        {{ 'blogs.article.name' | t }} {{ form.errors.messages['author'] }}
                      </span>
                    </small>
                  {%- endif -%}
                </div>
                <div class="field field--with-error">
                  <input
                    id="CommentForm-email"
                    type="email"
                    name="comment[email]"
                    autocomplete="email"
                    class="field__input required{% if form.errors contains 'email' %} invalid{% endif %}"
                    required="required"
                    value="{{ form.email }}"
                    autocorrect="off"
                    autocapitalize="off"
                    aria-required="true"
                    placeholder="{{ 'blogs.article.email' | t }}"
                    {%- if form.errors contains 'email' %}
                      aria-invalid="true"
                      aria-describedby="CommentForm-email-error"
                    {% endif -%}
                  />
                  <label class="visually-hidden" for="CommentForm-email">{{ 'blogs.article.email' | t }}</label>
                  {%- if form.errors contains 'email' -%}
                    <small id="CommentForm-email-error">
                      <span class="form__message errors">
                        {% render 'icon', icon: 'error' %}
                        {{ 'blogs.article.email' | t }} {{ form.errors.messages['email'] }}
                      </span>
                    </small>
                  {%- endif -%}
                </div>
              </div>
              <div class="field field--with-error">
                <textarea
                  id="CommentForm-body"
                  rows="5"
                  name="comment[body]"
                  class="text-area field__input required{% if form.errors contains 'body' %} invalid{% endif %}"
                  required="required"
                  aria-required="true"
                  placeholder="{{ 'blogs.article.message' | t }}"
                  {%- if form.errors contains 'body' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-body-error"
                  {% endif -%}
                >{{ form.body }}</textarea>
                <label class="visually-hidden" for="CommentForm-body">{{ 'blogs.article.message' | t }}</label>
              </div>
              {%- if form.errors contains 'body' -%}
                <small id="CommentForm-body-error">
                  <span class="form__message errors">
                    {% render 'icon', icon: 'error' %}
                    {{ 'blogs.article.message' | t }} {{ form.errors.messages['body'] }}
                  </span>
                </small>
              {%- endif -%}
            </div>
            <div class="article-template__comment-button">
              <button type="submit" class="button">{{ 'blogs.article.post' | t }}</button>
            </div>
            
            {% comment %}
              Remove the following three lines of code to remove the note
              about being protected by Google's reCAPTCHA service.
              By removing it, the small reCAPTCHA widget will appear in the
              bottom right corner of the page.
            {% endcomment %}
            <div class="rte">
              {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
            </div>
          {% endform %}
        </form-state>
      </div>
  </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ request.origin | append: page.url | json }}
  },
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | strip | truncate: 300 | json }},
  {% if article.image %}
  "image": [
    {{ article.image | image_url | prepend: "https:" | json }}
  ],
  {% endif %}
  "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "dateModified": {{ article.updated_at  | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "author": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}{% if settings.share_image %},
    "logo": {
      "@type": "ImageObject",
      "url": {{ settings.share_image | image_url | prepend: "https:" | json }},
      "width": {{ settings.share_image.width | json }},
      "height": {{ settings.share_image.height | json }}
    }{% endif %}
  },
  "articleBody": {{ article.content | strip_html | json }}
}
</script>


{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_gravatar",
      "default": true,
      "label": "t:sections.main-article.settings.show_gravatar.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "t:sections.all.padding.padding_top.unit",
      "label": "t:sections.all.padding.padding_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "t:sections.all.padding.padding_bottom.unit",
      "label": "t:sections.all.padding.padding_bottom.label",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_image",
      "name": "t:sections.main-article.blocks.featured_image.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "image_height",
          "options": [
            {
              "value": "adapt",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__1.label"
            },
            {
              "value": "medium",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__2.label"
            },
            {
              "value": "large",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__3.label"
            }
          ],
          "default": "adapt",
          "label": "t:sections.main-article.blocks.featured_image.settings.image_height.label",
          "info": "t:sections.main-article.blocks.featured_image.settings.image_height.info"
        }
      ]
    },
    {
      "type": "breadcrumb",
      "name": "t:sections.main-article.blocks.breadcrumb.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-article.blocks.breadcrumb.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.main-article.blocks.breadcrumb.settings.text_style.options__2.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.main-article.blocks.breadcrumb.settings.text_style.options__3.label"
            }
          ],
          "default": "body",
          "label": "t:sections.main-article.blocks.breadcrumb.settings.text_style.label"
        },
        {
          "type": "checkbox",
          "id": "show_divider",
          "default": false,
          "label": "t:sections.all.show_divider.label"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-article.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "blog_show_date",
          "default": true,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_date.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_author",
          "default": false,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_author.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_comment_count",
          "default": false,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_comment_count.label"
        }
      ]
    },
    {
      "type": "content",
      "name": "t:sections.main-article.blocks.content.name",
      "limit": 1
    },
    {
      "type": "share",
      "name": "t:sections.main-article.blocks.share.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "t:sections.main-article.blocks.share.settings.text.label",
          "default": "Share"
        },
        {
          "type": "paragraph",
          "content": "t:sections.main-article.blocks.share.settings.featured_image_info.content"
        },
        {
          "type": "paragraph",
          "content": "t:sections.main-article.blocks.share.settings.title_info.content"
        }
      ]
    },
    {
      "type": "back_to_blog",
      "name": "t:sections.main-article.blocks.back_to_blog.name",
      "limit": 1
    },
    {
      "type": "next_previous_posts",
      "name": "t:sections.main-article.blocks.next_previous_posts.name",
      "limit": 1
    }
  ]
}
{% endschema %}
