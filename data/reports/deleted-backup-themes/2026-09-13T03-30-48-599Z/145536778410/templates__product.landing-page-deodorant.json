    "hero-ingredient-cards": {
      "type": "multicolumn",
      "blocks": {
        "ingredient-card-1": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Coconut_Oil_Extract.webp",
            "title": "Organic Virgin Coconut Oil",
            "title_size": "medium",
            "text": "<p><em>Antimicrobial base.<\/em> Cold-pressed and unrefined, so it keeps its full lauric acid content. Lauric acid disrupts the lipid membrane of the bacteria that turn sweat into odor — the actual mechanism, not a sensory cue. Refined coconut oil is cheaper and more uniform, but the lab-deodorizing process strips out the molecule doing the work.<\/p>",
            "button_label": ""
          }
        },
        "ingredient-card-2": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Spring_Water.webp",
            "title": "Organic Jojoba",
            "title_size": "medium",
            "text": "<p><em>Skin-mirroring carrier.<\/em> Jojoba is structurally close to your skin's own sebum, so it absorbs without leaving an occlusive film that traps bacteria against the skin. Mineral oil and petrolatum are dramatically cheaper and more uniform, but they sit on top of skin and block its natural moisture exchange. Jojoba is the closest plant analog to sebum we know of.<\/p>",
            "button_label": ""
          }
        },
        "ingredient-card-3": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Wax.webp",
            "title": "Baking Soda",
            "title_size": "medium",
            "text": "<p><em>pH neutralizer.<\/em> Aluminum-free, food-grade sodium bicarbonate at a measured concentration. Odor-causing bacteria need an acidic environment to thrive; baking soda raises the pH and shuts that environment down. Some commercial baking sodas include aluminum-based anti-caking agents — not something we want anywhere near your skin. We pay more for the aluminum-free spec.<\/p>",
            "button_label": ""
          }
        }
      },
      "block_order": [
        "ingredient-card-1",
        "ingredient-card-2",
        "ingredient-card-3"
      ],
      "settings": {
        "heading": "Three ingredients, three jobs",
        "heading_size": "h2",
        "heading_alignment": "center",
        "heading_tag": "h2",
        "columns_desktop": 3,
        "columns_mobile": "1",
