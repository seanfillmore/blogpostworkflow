    "hook-rich-text": {
      "type": "rich-text",
      "blocks": {
        "hook-heading": {
          "type": "heading",
          "settings": {
            "heading": "Built around what neutralizes — not what plugs.",
            "heading_size": "h1",
            "heading_tag": "h2"
