    "hero-ingredient-cards": {
      "type": "multicolumn",
      "blocks": {
        "ingredient-card-1": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Coconut_Oil_Extract.webp",
            "title": "Organic Virgin Coconut Oil",
            "title_size": "medium",
            "text": "<p><em>Antimicrobial base.<\/em> Cold-pressed virgin coconut oil keeps its full lauric acid content, which disrupts the lipid membranes of decay-causing bacteria. Refined coconut oil is cheaper to formulate with — neutral, shelf-stable, uniform — but the deodorizing process strips out most of the lauric acid. The antimicrobial is the whole point, so we pay for the unrefined oil.<\/p>",
            "button_label": ""
          }
        },
        "ingredient-card-2": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Spring_Water.webp",
            "title": "Baking Soda",
            "title_size": "medium",
            "text": "<p><em>pH balancer and gentle polish.<\/em> Aluminum-free baking soda neutralizes the acidic environment cavity-causing bacteria need to thrive, and lifts surface stains with micro-abrasion softer than enamel. Hydrated silica, the cheap industry-standard abrasive, is harder than your teeth and wears them down over years of daily use. Baking soda is gentler and adds the pH benefit silica can't.<\/p>",
            "button_label": ""
          }
        },
        "ingredient-card-3": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Wax.webp",
            "title": "Wildcrafted Myrrh",
            "title_size": "medium",
            "text": "<p><em>Anti-inflammatory for irritated gums.<\/em> Wildcrafted myrrh resin contains sesquiterpenes — anti-inflammatory and antimicrobial compounds particularly soothing for inflamed gum tissue. Used in oral care for thousands of years. Most natural toothpastes skip myrrh because sustainable wildcrafted sourcing is expensive and inconsistent to scale. Customers with reactive gums tend to notice the difference within a couple weeks of switching.<\/p>",
            "button_label": ""
          }
        }
      },
      "block_order": [
        "ingredient-card-1",
        "ingredient-card-2",
        "ingredient-card-3"
      ],
      "settings": {
        "heading": "Three ingredients, three jobs",
