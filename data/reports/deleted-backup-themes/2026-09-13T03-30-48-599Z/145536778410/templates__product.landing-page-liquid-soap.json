    "hook-rich-text": {
      "type": "rich-text",
      "blocks": {
        "hook-heading": {
          "type": "heading",
          "settings": {
            "heading": "True soap, foaming dispenser, no detergents.",
            "heading_size": "h1",
            "heading_tag": "h2"
          }
        },
        "hook-text": {
          "type": "text",
          "settings": {
            "text": "<p>Soap works by surrounding oil and dirt with soap molecules so water can rinse them away — no sulfate detergents required. The foaming dispenser stretches a small amount of true coconut soap into a full lather, so your hands aren't hit with concentrated surfactant on every wash.<\/p>",
            "text_size": "typeset",
            "secondary_color": false
          }
