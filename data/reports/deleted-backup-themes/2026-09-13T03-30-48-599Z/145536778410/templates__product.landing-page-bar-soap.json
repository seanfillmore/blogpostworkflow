    "hook-rich-text": {
      "type": "rich-text",
      "blocks": {
        "hook-heading": {
          "type": "heading",
          "settings": {
            "heading": "One ingredient. True soap. No detergent.",
            "heading_size": "h1",
            "heading_tag": "h2"
          }
        },
        "hook-text": {
