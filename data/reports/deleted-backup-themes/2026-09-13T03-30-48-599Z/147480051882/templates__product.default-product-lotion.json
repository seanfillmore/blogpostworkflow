    "jdgm_featured_reviews_3up_r9ekPA": {
      "type": "jdgm-featured-reviews-3up",
      "name": "Featured reviews (3-up) — Judge.me",
      "settings": {
        "bg_color": "#efefef",
        "heading": "Real People. Real Results",
