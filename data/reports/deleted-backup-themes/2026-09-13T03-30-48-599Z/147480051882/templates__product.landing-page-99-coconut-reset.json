        "tab-whats-inside": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "box",
            "heading": "What's Inside",
            "content": "<p><strong>3 full-size Body Lotions.<\/strong> Lotion is your daily driver — morning, after showers, after handwashing. You reach for it most, so you get three.<\/p><p><strong>1 full-size Body Cream.<\/strong> Your overnight repair layer for dry patches, hands, elbows, and knees. A little goes a long way, so one jar lasts the full window.<\/p><p><strong>2 digital guides (delivered to your inbox).<\/strong> The 90-Day Calm-Skin Routine &amp; Tracker and the Coconut Skincare Field Guide — so you actually stick with the reset.<\/p><p>Together that's about 90 days of daily use for one person: enough time for skin to actually turn a corner instead of starting over every few weeks.<\/p>",
            "page": "",
            "custom_liquid": "",
            "keep_open": true
          }
        },
        "tab-ingredients": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "check_mark",
            "heading": "Ingredients",
            "content": "<p><strong>Coconut Body Lotion:<\/strong> Purified spring water, organic virgin coconut oil, organic jojoba, plant-based emulsifying wax, organic grapefruit seed extract, organic red palm oil.<\/p><p><strong>Coconut Body Cream:<\/strong> Purified spring water, organic virgin coconut oil, plant-based emulsifying wax, palm stearic, grapefruit seed extract, organic beeswax, organic red palm oil.<\/p><p>Choose Pure Unscented for no added fragrance of any kind, or a lightly scented option at checkout.<\/p>",
            "page": "",
            "custom_liquid": "",
            "keep_open": false
          }
        },
        "tab-howto": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "clipboard",
            "heading": "How to Use",
            "content": "<p><strong>Daily (lotion):<\/strong> Apply to clean, dry skin after a shower or whenever skin feels tight. Massage in fully — it should absorb within minutes without sticky residue.<\/p><p><strong>Overnight (cream):<\/strong> Warm a small amount between your fingers and apply to dry patches before bed. Best on elbows, knees, hands, and feet — areas that need more than a daytime lotion can give.<\/p><p>If either formula is firm in cold weather, warm a small amount between your palms first. Cold-pressed coconut oil firms below 76°F.<\/p>",
            "page": "",
            "custom_liquid": "",
            "keep_open": false
          }
        },
        "tab-shipping": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "box",
            "heading": "Shipping & Returns",
            "content": "<p>Free shipping included on your 90-Day Reset. Standard delivery 2 business days within the US. Expedited shipping available at checkout. This is a one-time order — no subscription, no auto-billing.<\/p><p>Not loving your reset? Email us within 30 days of receipt for a full refund — you don't need to send the product back. See our <a href=\"\/policies\/shipping-policy\">Shipping Policy<\/a> and <a href=\"\/policies\/refund-policy\">Return Policy<\/a> for full details.<\/p>",
            "page": "",
            "custom_liquid": "",
            "keep_open": false
          }
        },
        "vqr-combo": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.vqr-row{display:flex;gap:12px;align-items:flex-end;justify-content:flex-start;margin:14px 0}\n.vqr-col{display:flex;flex-direction:column}\n.vqr-col--variant{flex:0 0 32%;min-width:140px}\n.vqr-col--qty{flex:0 0 auto;width:130px}\n.vqr-label{font-size:11px;letter-spacing:1px;text-transform:uppercase;margin:0 0 6px 0;font-weight:500;color:#1a1b18}\n.vqr-select{padding:11px 12px;border:1px solid #d3d3d3;border-radius:6px;background:#fff;font-size:14px;color:#1a1b18;height:42px}\n.vqr-stepper{display:flex;align-items:stretch;border:1px solid #d3d3d3;border-radius:6px;overflow:hidden;background:#fff;height:42px}\n.vqr-stepper button{background:#fff;border:none;padding:0 10px;font-size:18px;cursor:pointer;color:#1a1b18;line-height:1}\n.vqr-stepper button:hover{background:#f5f5f5}\n.vqr-stepper input{flex:1;text-align:center;border:none;padding:0 2px;font-size:14px;font-weight:500;-moz-appearance:textfield;min-width:0;background:#fff}\n.vqr-stepper input::-webkit-outer-spin-button,.vqr-stepper input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}\n.product-form__input--variant-picker,.product-form__input.variant-input-wrapper,variant-selects:not([data-vqr-skip]){display:none !important}\n<\/style>\n<div class=\"vqr-row\">\n  {%- if product.variants.size > 1 -%}\n  <div class=\"vqr-col vqr-col--variant\">\n    <label class=\"vqr-label\" for=\"vqr-variant-{{ product.id }}\">{{ product.options[0] | default: 'Scent' }}<\/label>\n    <select class=\"vqr-select\" id=\"vqr-variant-{{ product.id }}\" data-vqr-variant>\n      {%- for v in product.variants -%}\n        <option value=\"{{ v.id }}\"{% if v == product.selected_or_first_available_variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>\n          {{- v.title }}{% unless v.available %} - Sold out{% endunless -%}\n        <\/option>\n      {%- endfor -%}\n    <\/select>\n  <\/div>\n  {%- endif -%}\n  <div class=\"vqr-col vqr-col--qty\">\n    <label class=\"vqr-label\" for=\"vqr-qty-{{ product.id }}\">Quantity<\/label>\n    <div class=\"vqr-stepper\">\n      <button type=\"button\" data-vqr-qty-minus aria-label=\"Decrease quantity\">&minus;<\/button>\n      <input id=\"vqr-qty-{{ product.id }}\" type=\"number\" name=\"quantity\" value=\"1\" min=\"1\" data-vqr-qty form=\"product-form-{{ section.id }}\">\n      <button type=\"button\" data-vqr-qty-plus aria-label=\"Increase quantity\">+<\/button>\n    <\/div>\n  <\/div>\n<\/div>\n<script>\n(function(){\n  \/\/ Bound once. Dawn replaces the product info container on every variant change, so the\n  \/\/ picker and stepper are new DOM nodes each time — listeners bound to the elements\n  \/\/ themselves die after the first switch. Inline scripts in replaced markup do not run,\n  \/\/ so nothing re-binds. Delegation on document is what makes this survive.\n  if(window.__vqrDelegated){ return; }\n  window.__vqrDelegated = true;\n\n  \/\/ variant id -> its option values. Covers multi-option bundles (Configuration + Scent),\n  \/\/ not just the first select.\n  var VQR_OPTION_VALUES = {\n    {%- for v in product.variants -%}\n    \"{{ v.id }}\": [{% for o in v.options %}{{ o | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% unless forloop.last %},{% endunless %}\n    {%- endfor -%}\n  };\n\n  document.addEventListener('change', function(e){\n    var pick = e.target;\n    if(!pick || !pick.matches || !pick.matches('select[data-vqr-variant]')){ return; }\n    var opts = VQR_OPTION_VALUES[pick.value];\n    if(!opts){ return; }\n\n    var root = document.querySelector('variant-selects:not([data-vqr-skip])');\n    var selects = root ? root.querySelectorAll('select') : [];\n    if(selects.length){\n      \/\/ Assign the OPTION VALUE, never the variant id — an id matches no option, so the\n      \/\/ select silently empties and the gallery never updates.\n      for(var i = 0; i < selects.length; i++){\n        if(opts[i] != null){ selects[i].value = opts[i]; }\n      }\n      selects[selects.length - 1].dispatchEvent(new Event('change', { bubbles: true }));\n      return;\n    }\n    var radios = document.querySelectorAll('variant-radios input[type=\"radio\"]');\n    radios.forEach(function(r){\n      if(opts.indexOf(r.value) !== -1){ r.checked = true; r.dispatchEvent(new Event('change',{bubbles:true})); }\n    });\n  });\n\n  document.addEventListener('click', function(e){\n    var btn = e.target.closest && e.target.closest('[data-vqr-qty-minus], [data-vqr-qty-plus]');\n    if(!btn){ return; }\n    var wrap = btn.closest('.vqr-stepper') || btn.parentElement;\n    var qty = wrap && wrap.querySelector('input');\n    if(!qty){ return; }\n    var v = parseInt(qty.value, 10) || 1;\n    var next = btn.hasAttribute('data-vqr-qty-minus') ? Math.max(1, v - 1) : v + 1;\n    if(next !== v){ qty.value = next; qty.dispatchEvent(new Event('change',{bubbles:true})); }\n  });\n})();\n<\/script>"
          }
        },
