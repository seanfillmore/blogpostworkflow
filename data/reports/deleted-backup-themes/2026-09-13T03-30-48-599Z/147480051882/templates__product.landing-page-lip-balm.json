    "hero-ingredient-cards": {
      "type": "multicolumn",
      "blocks": {
        "ingredient-card-1": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Wax.webp",
            "title": "Organic Beeswax",
            "title_size": "medium",
            "text": "<p><em>Moisture-lock barrier.<\/em> Beeswax forms a breathable film on the lips that holds moisture in without occluding the way petrolatum does. Its long-chain fatty acids and esters give the balm its stick structure and let it stay put through wear. Petrolatum and microcrystalline wax are cheaper and more occlusive — we chose beeswax because the lips can still exchange.<\/p>",
            "button_label": ""
          }
        },
        "ingredient-card-2": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/Coconut_Oil_Extract.webp",
            "title": "Organic Virgin Coconut Oil",
            "title_size": "medium",
            "text": "<p><em>Nourishing fatty acid base.<\/em> Cold-pressed virgin coconut oil delivers medium-chain fatty acids — roughly half of which is lauric acid — into the thin skin of the lips. Where petrolatum sits on top, virgin coconut oil absorbs and feeds. Refined coconut oil is cheaper and more uniform, but the deodorizing process strips out the lauric acid that does the work.<\/p>",
            "button_label": ""
          }
        },
        "ingredient-card-3": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/red-palm-fruit.webp",
            "title": "Organic Red Palm Oil",
            "title_size": "medium",
            "text": "<p><em>Vitamin E and beta-carotene source.<\/em> Unrefined red palm oil delivers naturally occurring vitamin E and tocotrienols to the thin skin of the lips — antioxidants that support tissue health where it shows fastest. The deep red-orange color is the carotenoids themselves. RSPO-certified sourcing.<\/p>",
            "button_label": ""
          }
        }
      },
      "block_order": [
        "ingredient-card-1",
        "ingredient-card-2",
        "ingredient-card-3"
      ],
      "settings": {
        "image_ratio": "adapt",
        "image_position": "top",
        "text_alignment": "left",
        "show_divider": false,
        "image_width": "full",
        "columns_desktop": 3,
        "heading": "Three ingredients, three jobs",
        "heading_size": "h2",
        "heading_alignment": "center",
        "heading_tag": "h2",
        "columns_mobile": "1",
        "swipe_on_mobile": false,
