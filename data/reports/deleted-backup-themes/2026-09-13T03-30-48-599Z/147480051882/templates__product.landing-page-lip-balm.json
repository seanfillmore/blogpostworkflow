        "ymal-recommendations": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.ymal-section{margin:24px 0 8px 0;padding-top:24px;border-top:1px solid #e5e5e5}\n.ymal-section h3{font-size:14px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;margin:0 0 16px 0;color:#1a1b18}\n.ymal-cards{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:thin;padding-bottom:8px;margin:0 -4px;align-items:stretch}\n.ymal-cards::-webkit-scrollbar{height:6px}\n.ymal-cards::-webkit-scrollbar-thumb{background:#d3d3d3;border-radius:3px}\n.ymal-card{flex:0 0 calc(40% - 7px);scroll-snap-align:start;display:flex;flex-direction:column;gap:6px}\n.ymal-card-img{display:block;background:#f5f5f5;border-radius:8px;overflow:hidden;aspect-ratio:1\/1}\n.ymal-card-img img{width:100%;height:100%;object-fit:cover;display:block}\n.ymal-card-title{font-size:14px;font-weight:500;color:#1a1b18;text-decoration:none;line-height:1.3;margin-top:8px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;min-height:2.6em}\n.ymal-card-variant{font-size:11px;letter-spacing:0.8px;text-transform:uppercase;color:#6d7175;min-height:1.2em;display:block}\n.ymal-card-add{margin-top:auto;padding:10px;background:#eef3e8;border:none;border-radius:6px;font-size:12px;font-weight:700;letter-spacing:1px;color:#2d5a2d;cursor:pointer;transition:background 0.15s}\n.ymal-card-add:hover{background:#AEDEAC}\n.ymal-card-add:disabled{opacity:0.6;cursor:default}\n@media(min-width:990px){.ymal-card{flex:0 0 calc(32% - 8px)}}\n\n.ymal-modal{position:fixed;inset:0;background:rgba(26,27,24,0.55);z-index:9999;display:none;align-items:center;justify-content:center;padding:16px;opacity:0;transition:opacity 0.2s}\n.ymal-modal[data-open=\"true\"]{display:flex;opacity:1}\n.ymal-modal__panel{background:#fff;border-radius:12px;max-width:420px;width:100%;max-height:90vh;overflow-y:auto;padding:20px 22px 22px 22px;position:relative;box-shadow:0 20px 60px rgba(0,0,0,0.25)}\n.ymal-modal__close{position:absolute;top:12px;right:12px;background:none;border:none;font-size:24px;line-height:1;cursor:pointer;color:#6d7175;padding:4px 8px}\n.ymal-modal__close:hover{color:#1a1b18}\n.ymal-modal__hd{display:flex;gap:12px;align-items:center;margin-bottom:16px}\n.ymal-modal__img{width:72px;height:72px;background:#f5f5f5;border-radius:8px;overflow:hidden;flex-shrink:0}\n.ymal-modal__img img{width:100%;height:100%;object-fit:cover;display:block}\n.ymal-modal__title{font-size:16px;font-weight:600;color:#1a1b18;margin:0 24px 4px 0;line-height:1.3}\n.ymal-modal__price{font-size:14px;color:#1a1b18;font-weight:500}\n.ymal-modal__opt-label{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#1a1b18;font-weight:700;margin:0 0 8px 0}\n.ymal-modal__variants{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}\n.ymal-modal__variant{padding:8px 12px;background:#fff;border:2px solid #d3d3d3;border-radius:6px;font-size:12px;font-weight:500;cursor:pointer;color:#1a1b18;transition:all 0.15s;-webkit-tap-highlight-color:transparent}\n.ymal-modal__variant:hover{border-color:#4a8b3c}\n.ymal-modal__variant[data-selected=\"true\"]{border-color:#4a8b3c;background:#eef3e8;color:#2d5a2d}\n.ymal-modal__variant[data-soldout=\"true\"]{opacity:0.45;text-decoration:line-through;cursor:not-allowed}\n.ymal-modal__add{width:100%;padding:14px;background:#1a1b18;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;letter-spacing:1px;cursor:pointer;transition:background 0.15s}\n.ymal-modal__add:hover{background:#000}\n.ymal-modal__add:disabled{opacity:0.6;cursor:default}\n.ymal-modal__add[data-state=\"added\"]{background:#4a8b3c}\n<\/style>\n<div class=\"ymal-section\" id=\"ymal-{{ product.id }}\" style=\"display:none\">\n  <h3>You may also like<\/h3>\n  <div class=\"ymal-cards\" id=\"ymal-cards-{{ product.id }}\"><\/div>\n<\/div>\n<div class=\"ymal-modal\" id=\"ymal-modal-{{ product.id }}\" data-open=\"false\" role=\"dialog\" aria-modal=\"true\">\n  <div class=\"ymal-modal__panel\">\n    <button type=\"button\" class=\"ymal-modal__close\" aria-label=\"Close\">×<\/button>\n    <div class=\"ymal-modal__hd\">\n      <div class=\"ymal-modal__img\"><img alt=\"\"><\/div>\n      <div>\n        <h4 class=\"ymal-modal__title\"><\/h4>\n        <div class=\"ymal-modal__price\"><\/div>\n      <\/div>\n    <\/div>\n    <p class=\"ymal-modal__opt-label\"><\/p>\n    <div class=\"ymal-modal__variants\"><\/div>\n    <button type=\"button\" class=\"ymal-modal__add\" data-state=\"idle\">ADD TO CART<\/button>\n  <\/div>\n<\/div>\n<script>\n(function(){\n  var pid = {{ product.id }};\n  var section = document.getElementById('ymal-'+pid);\n  var container = document.getElementById('ymal-cards-'+pid);\n  var modal = document.getElementById('ymal-modal-'+pid);\n  if(!section || !container || !modal) return;\n  var productsCache = {};\n\n  function imgUrl(src, size){\n    if(!src) return '';\n    return src.replace(\/(\\.[^.?]+)(\\?.*)?$\/, '_'+size+'$1$2');\n  }\n  function fmtMoney(cents){\n    return '$' + (cents\/100).toFixed(2);\n  }\n  function escapeHtml(s){\n    return String(s).replace(\/[&<>\"']\/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];});\n  }\n\n  function openModal(prod){\n    var v = prod.variants.find(function(x){return x.available;}) || prod.variants[0];\n    var optName = (prod.options && prod.options[0]) || 'Option';\n    var img = prod.featured_image || (prod.images && prod.images[0] && prod.images[0].src) || '';\n    modal.querySelector('.ymal-modal__img img').src = imgUrl(img, '160x160');\n    modal.querySelector('.ymal-modal__img img').alt = prod.title;\n    modal.querySelector('.ymal-modal__title').textContent = prod.title;\n    modal.querySelector('.ymal-modal__price').textContent = fmtMoney(v.price);\n    modal.querySelector('.ymal-modal__opt-label').textContent = (typeof optName === 'string' ? optName : (optName.name || 'Option'));\n    var picker = modal.querySelector('.ymal-modal__variants');\n    picker.innerHTML = prod.variants.map(function(x){\n      return '<button type=\"button\" class=\"ymal-modal__variant\" data-vid=\"'+x.id+'\" data-price=\"'+x.price+'\" data-soldout=\"'+(!x.available)+'\">'+escapeHtml(x.title)+'<\/button>';\n    }).join('');\n    var btns = picker.querySelectorAll('.ymal-modal__variant');\n    btns.forEach(function(b){\n      b.addEventListener('click', function(){\n        if(b.dataset.soldout === 'true') return;\n        btns.forEach(function(x){ x.dataset.selected = 'false'; });\n        b.dataset.selected = 'true';\n        modal.querySelector('.ymal-modal__price').textContent = fmtMoney(parseInt(b.dataset.price, 10));\n      });\n    });\n    var firstAvail = picker.querySelector('.ymal-modal__variant:not([data-soldout=\"true\"])');\n    if(firstAvail) firstAvail.dataset.selected = 'true';\n    var addBtn = modal.querySelector('.ymal-modal__add');\n    addBtn.dataset.state = 'idle';\n    addBtn.disabled = false;\n    addBtn.textContent = 'ADD TO CART';\n    modal.dataset.open = 'true';\n    document.body.style.overflow = 'hidden';\n  }\n  function closeModal(){\n    modal.dataset.open = 'false';\n    document.body.style.overflow = '';\n  }\n\n  modal.querySelector('.ymal-modal__close').addEventListener('click', closeModal);\n  modal.addEventListener('click', function(e){ if(e.target === modal) closeModal(); });\n  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && modal.dataset.open === 'true') closeModal(); });\n\n  modal.querySelector('.ymal-modal__add').addEventListener('click', function(){\n    var sel = modal.querySelector('.ymal-modal__variant[data-selected=\"true\"]');\n    if(!sel) return;\n    var addBtn = modal.querySelector('.ymal-modal__add');\n    addBtn.disabled = true;\n    addBtn.textContent = 'ADDING...';\n    fetch('\/cart\/add.js', {\n      method: 'POST',\n      headers: {'Content-Type': 'application\/json'},\n      body: JSON.stringify({ id: sel.dataset.vid, quantity: 1 })\n    }).then(function(r){\n      if(!r.ok) throw new Error();\n      addBtn.dataset.state = 'added';\n      addBtn.textContent = 'ADDED ✓';\n      document.dispatchEvent(new CustomEvent('cart:refresh'));\n      setTimeout(closeModal, 800);\n    }).catch(function(){\n      addBtn.disabled = false;\n      addBtn.textContent = 'ADD TO CART';\n    });\n  });\n\n  fetch('\/recommendations\/products.json?product_id='+pid+'&limit=6&intent=related')\n    .then(function(r){ return r.json(); })\n    .then(function(data){\n      var products = (data && data.products) || [];\n      if(!products.length) return;\n      products.forEach(function(p){ productsCache[p.id] = p; });\n      section.style.display = 'block';\n      container.innerHTML = products.map(function(p){\n        var v = p.variants[0];\n        var img = p.featured_image || (p.images && p.images[0] && p.images[0].src) || '';\n        var url = imgUrl(img, '400x400');\n        var variant = v.title === 'Default Title' ? '' : v.title;\n        var multi = p.variants.length > 1;\n        return '<div class=\"ymal-card\"><a class=\"ymal-card-img\" href=\"'+p.url+'\"><img src=\"'+url+'\" alt=\"'+escapeHtml(p.title)+'\" loading=\"lazy\"><\/a><a class=\"ymal-card-title\" href=\"'+p.url+'\">'+escapeHtml(p.title)+'<\/a><div class=\"ymal-card-variant\">'+escapeHtml(variant)+'<\/div><button class=\"ymal-card-add\" data-pid=\"'+p.id+'\" data-vid=\"'+v.id+'\" data-multi=\"'+multi+'\">ADD<\/button><\/div>';\n      }).join('');\n      container.querySelectorAll('.ymal-card-add').forEach(function(btn){\n        btn.addEventListener('click', function(){\n          var multi = btn.dataset.multi === 'true';\n          var prod = productsCache[btn.dataset.pid];\n          if(multi && prod){\n            openModal(prod);\n            return;\n          }\n          btn.disabled = true;\n          btn.textContent = 'ADDING...';\n          fetch('\/cart\/add.js', {\n            method: 'POST',\n            headers: {'Content-Type': 'application\/json'},\n            body: JSON.stringify({ id: btn.dataset.vid, quantity: 1 })\n          }).then(function(r){\n            if(!r.ok) throw new Error();\n            btn.textContent = 'ADDED ✓';\n            document.dispatchEvent(new CustomEvent('cart:refresh'));\n            setTimeout(function(){ btn.textContent = 'ADD'; btn.disabled = false; }, 2000);\n          }).catch(function(){\n            btn.textContent = 'ADD';\n            btn.disabled = false;\n          });\n        });\n      });\n    })\n    .catch(function(e){ console.warn('YMAL fetch failed', e); });\n})();\n<\/script>\n"
          }
        },
        "tab-details": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "leaf",
            "heading": "Details",
            "content": "<p><strong>Three ingredients, three jobs.<\/strong> Beeswax (true breathable barrier), virgin coconut oil (medium-chain fatty acids that nourish), unrefined red palm oil (vitamin E and tocotrienols).<\/p><p><strong>No petroleum jelly, no lanolin, no synthetic flavoring.<\/strong> The chronic-chap problem we usually trace to one of those three ingredients.<\/p><p><strong>No menthol cooling sensation.<\/strong> Many commercial balms add menthol to feel \"treated\" — that's mild irritation, not healing.<\/p><p><strong>Honest trade-off.<\/strong> Firmer than a petrolatum-based balm because beeswax sets harder than petroleum wax. Apply with light pressure rather than a smear.<\/p>",
            "page": "",
            "custom_liquid": "",
            "keep_open": false
          }
        },
        "tab-ingredients": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "check_mark",
            "heading": "Ingredients",
            "content": "<p>Organic virgin coconut oil, organic beeswax, organic red palm oil.<\/p><p><strong>Variation essential oils:<\/strong><\/p><ul><li><strong>Vanilla Dream:<\/strong> organic vanilla extract<\/li><li><strong>Sweet Tangerine:<\/strong> tangerine, orange, lemon<\/li><li><strong>Coconut Breeze:<\/strong> organic coconut oil extract<\/li><li><strong>Pure Unscented:<\/strong> none<\/li><\/ul>",
            "page": "",
            "custom_liquid": "",
            "keep_open": true
          }
        },
        "tab-howto": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "clipboard",
            "heading": "How to Use",
            "content": "<p>Apply with light pressure to the lips — let the warmth of the lips soften the balm into place. Reapply throughout the day, especially in dry weather.<\/p>",
            "page": "",
            "custom_liquid": "",
            "keep_open": false
          }
        },
        "tab-shipping": {
          "type": "collapsible_tab",
          "settings": {
            "icon": "box",
            "heading": "Shipping & Returns",
            "content": "<p>Free shipping on orders $45+. Standard delivery 2 business days within the US. Expedited shipping available at checkout.<\/p><p>Not loving your purchase? Email us within 30 days of receipt for a full refund — you don't need to send the product back. See our <a href=\"\/policies\/shipping-policy\">Shipping Policy<\/a> and <a href=\"\/policies\/refund-policy\">Return Policy<\/a> for full details.<\/p>",
            "page": "",
            "custom_liquid": "",
            "keep_open": false
          }
        },
        "vqr-combo": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n.vqr-row{display:flex;gap:12px;align-items:flex-end;justify-content:flex-start;margin:14px 0}\n.vqr-col{display:flex;flex-direction:column}\n.vqr-col--variant{flex:0 0 32%;min-width:140px}\n.vqr-col--qty{flex:0 0 auto;width:130px}\n.vqr-label{font-size:11px;letter-spacing:1px;text-transform:uppercase;margin:0 0 6px 0;font-weight:500;color:#1a1b18}\n.vqr-select{padding:11px 12px;border:1px solid #d3d3d3;border-radius:6px;background:#fff;font-size:14px;color:#1a1b18;height:42px}\n.vqr-stepper{display:flex;align-items:stretch;border:1px solid #d3d3d3;border-radius:6px;overflow:hidden;background:#fff;height:42px}\n.vqr-stepper button{background:#fff;border:none;padding:0 10px;font-size:18px;cursor:pointer;color:#1a1b18;line-height:1}\n.vqr-stepper button:hover{background:#f5f5f5}\n.vqr-stepper input{flex:1;text-align:center;border:none;padding:0 2px;font-size:14px;font-weight:500;-moz-appearance:textfield;min-width:0;background:#fff}\n.vqr-stepper input::-webkit-outer-spin-button,.vqr-stepper input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}\n.product-form__input--variant-picker,.product-form__input.variant-input-wrapper,variant-selects:not([data-vqr-skip]){display:none !important}\n<\/style>\n<div class=\"vqr-row\">\n  {%- if product.variants.size > 1 -%}\n  <div class=\"vqr-col vqr-col--variant\">\n    <label class=\"vqr-label\" for=\"vqr-variant-{{ product.id }}\">{{ product.options[0] | default: 'Scent' }}<\/label>\n    <select class=\"vqr-select\" id=\"vqr-variant-{{ product.id }}\" data-vqr-variant>\n      {%- for v in product.variants -%}\n        <option value=\"{{ v.id }}\"{% if v == product.selected_or_first_available_variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>\n          {{- v.title }}{% unless v.available %} - Sold out{% endunless -%}\n        <\/option>\n      {%- endfor -%}\n    <\/select>\n  <\/div>\n  {%- endif -%}\n  <div class=\"vqr-col vqr-col--qty\">\n    <label class=\"vqr-label\" for=\"vqr-qty-{{ product.id }}\">Quantity<\/label>\n    <div class=\"vqr-stepper\">\n      <button type=\"button\" data-vqr-qty-minus aria-label=\"Decrease quantity\">&minus;<\/button>\n      <input id=\"vqr-qty-{{ product.id }}\" type=\"number\" name=\"quantity\" value=\"1\" min=\"1\" data-vqr-qty form=\"product-form-{{ section.id }}\">\n      <button type=\"button\" data-vqr-qty-plus aria-label=\"Increase quantity\">+<\/button>\n    <\/div>\n  <\/div>\n<\/div>\n<script>\n(function(){\n  \/\/ Bound once. Dawn replaces the product info container on every variant change, so the\n  \/\/ picker and stepper are new DOM nodes each time — listeners bound to the elements\n  \/\/ themselves die after the first switch. Inline scripts in replaced markup do not run,\n  \/\/ so nothing re-binds. Delegation on document is what makes this survive.\n  if(window.__vqrDelegated){ return; }\n  window.__vqrDelegated = true;\n\n  \/\/ variant id -> its option values. Covers multi-option bundles (Configuration + Scent),\n  \/\/ not just the first select.\n  var VQR_OPTION_VALUES = {\n    {%- for v in product.variants -%}\n    \"{{ v.id }}\": [{% for o in v.options %}{{ o | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% unless forloop.last %},{% endunless %}\n    {%- endfor -%}\n  };\n\n  document.addEventListener('change', function(e){\n    var pick = e.target;\n    if(!pick || !pick.matches || !pick.matches('select[data-vqr-variant]')){ return; }\n    var opts = VQR_OPTION_VALUES[pick.value];\n    if(!opts){ return; }\n\n    var root = document.querySelector('variant-selects:not([data-vqr-skip])');\n    var selects = root ? root.querySelectorAll('select') : [];\n    if(selects.length){\n      \/\/ Assign the OPTION VALUE, never the variant id — an id matches no option, so the\n      \/\/ select silently empties and the gallery never updates.\n      for(var i = 0; i < selects.length; i++){\n        if(opts[i] != null){ selects[i].value = opts[i]; }\n      }\n      selects[selects.length - 1].dispatchEvent(new Event('change', { bubbles: true }));\n      return;\n    }\n    var radios = document.querySelectorAll('variant-radios input[type=\"radio\"]');\n    radios.forEach(function(r){\n      if(opts.indexOf(r.value) !== -1){ r.checked = true; r.dispatchEvent(new Event('change',{bubbles:true})); }\n    });\n  });\n\n  document.addEventListener('click', function(e){\n    var btn = e.target.closest && e.target.closest('[data-vqr-qty-minus], [data-vqr-qty-plus]');\n    if(!btn){ return; }\n    var wrap = btn.closest('.vqr-stepper') || btn.parentElement;\n    var qty = wrap && wrap.querySelector('input');\n    if(!qty){ return; }\n    var v = parseInt(qty.value, 10) || 1;\n    var next = btn.hasAttribute('data-vqr-qty-minus') ? Math.max(1, v - 1) : v + 1;\n    if(next !== v){ qty.value = next; qty.dispatchEvent(new Event('change',{bubbles:true})); }\n  });\n})();\n<\/script>"
          }
        },
