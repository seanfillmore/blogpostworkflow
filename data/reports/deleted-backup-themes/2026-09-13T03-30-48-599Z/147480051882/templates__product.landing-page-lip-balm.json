    "hook-rich-text": {
      "type": "rich-text",
      "blocks": {
        "hook-heading": {
          "type": "heading",
          "settings": {
            "heading": "Three ingredients. Barrier, nourishment, antioxidant.",
            "heading_size": "h1",
            "heading_tag": "h2"
          }
        },
        "hook-text": {
          "type": "text",
          "settings": {
            "text": "<p>Beeswax locks moisture in without occluding. Coconut oil absorbs and feeds the thin skin of the lips. Unrefined red palm oil contributes tocotrienols and beta-carotene — antioxidants that protect the barrier the balm is meant to build.<\/p>",
            "text_size": "typeset",
            "secondary_color": false
