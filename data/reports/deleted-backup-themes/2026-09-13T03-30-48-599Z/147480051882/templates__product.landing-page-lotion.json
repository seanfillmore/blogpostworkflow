        "ingredient-card-2": {
          "type": "column",
          "settings": {
            "background_color": "#f2f2f2",
            "heading_color": "#000000",
            "text_color": "#333333",
            "image": "shopify:\/\/shop_images\/Jojoba.webp",
            "title": "Organic Jojoba",
            "title_size": "medium",
            "text": "<p><em>Skin-mirroring carrier oil.<\/em> Jojoba is technically a wax ester, not an oil — its molecular structure is close enough to human sebum that skin recognizes and absorbs it without forming an occlusive film. That's why this lotion isn't greasy. Mineral oil and dimethicone are cheaper and form a more uniform film. They also seal everything else underneath them.<\/p>",
            "show_popup": false,
            "popup_image_position": "top",
            "justify_text": false,
            "button_label": "",
            "button_link": "",
            "button_style_secondary": false,
