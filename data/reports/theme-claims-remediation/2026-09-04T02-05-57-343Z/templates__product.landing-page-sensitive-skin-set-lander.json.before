    "stats-hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>#shopify-section-{{ section.id }}{background-color:#faf7f0}.stats-hero{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;color:#212326;padding:24px 0}.stats-hero__media{aspect-ratio:1\/1;background:#eef3e8;border-radius:12px;overflow:hidden}.stats-hero__media img{width:100%;height:100%;object-fit:cover;display:block}.stats-hero__copy h2{font-size:clamp(2rem,3.6vw,3.25rem);line-height:1.1;margin:0 0 36px 0;font-weight:700;letter-spacing:-0.01em}.stats-hero__stat{margin-bottom:32px}.stats-hero__num{display:block;font-size:clamp(3.5rem,7vw,6.5rem);color:#4a8b3c;line-height:0.95;font-weight:800;margin-bottom:10px;letter-spacing:-0.02em}.stats-hero__desc{font-size:1.25rem;line-height:1.4;margin:0;max-width:520px}.stats-hero__sup{font-size:0.6em;vertical-align:super;color:#4a8b3c;font-weight:700}.stats-hero__footnote{font-size:0.875rem;color:#6d7175;margin-top:32px;line-height:1.55;max-width:520px}@media(max-width:749px){.stats-hero{grid-template-columns:1fr;gap:24px;padding:8px 0}.stats-hero__copy h2{font-size:1.875rem;margin-bottom:24px}.stats-hero__num{font-size:3rem}.stats-hero__desc{font-size:1.05rem}.stats-hero__stat{margin-bottom:20px}}<\/style><div class=\"stats-hero\"><div class=\"stats-hero__copy\"><h2>Modern Skincare Is Failing Sensitive Skin<\/h2><div class=\"stats-hero__stat\"><span class=\"stats-hero__num\">51%<\/span><p class=\"stats-hero__desc\">of American women report sensitive skin.<span class=\"stats-hero__sup\">1<\/span><\/p><\/div><div class=\"stats-hero__stat\"><span class=\"stats-hero__num\">#1<\/span><p class=\"stats-hero__desc\">cause of cosmetic-related allergic reactions: synthetic fragrance.<span class=\"stats-hero__sup\">2<\/span><\/p><\/div><p class=\"stats-hero__footnote\"><span class=\"stats-hero__sup\">1<\/span> Misery et al., Int J Dermatol, 2011 (US population study: women 50.9%, men 38.2%). <span class=\"stats-hero__sup\">2<\/span> North American Contact Dermatitis Group Patch Test Results, 2021–2022.<\/p><\/div><div class=\"stats-hero__media\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0270\/1911\/6579\/files\/stats-hand-applying.webp?v=1778128505\" alt=\"Hand applying Pure Unscented Body Lotion to a forearm in soft daylight\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;\"><\/div><\/div>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
