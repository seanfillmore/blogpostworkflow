    "compare-table-styles": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>.compare-table__wrap{position:relative !important}.compare-table__wrap::before{content:\"\";position:absolute;top:0;bottom:0;left:27.27%;width:18.18%;background:#eef3e8;border:2px solid #a8d1a3;border-radius:12px;z-index:0;pointer-events:none}@media(max-width:991.98px){.compare-table__wrap::before{left:40%;width:30%}}.compare-table__row--header{background:transparent !important}.compare-table__cell--us::before{display:none !important}.compare-table__cell--us{background:transparent !important;border:0 !important;position:relative;z-index:1}.compare-table__cell--us > *{position:relative;z-index:2}.compare-table__row:not(.compare-table__row--header)::after{left:0;right:auto;width:27.27%;background:#e7e9ef;z-index:0}@media(max-width:991.98px){.compare-table__row:not(.compare-table__row--header)::after{width:40%}}[id*=\"final-cta-strip\"] .button--cta{border:1px solid #444 !important}[id*=\"stats-row\"] .multicolumn-card__title{font-size:clamp(2rem,4vw,3.25rem) !important;color:#4a8b3c !important;font-weight:800 !important;text-align:center !important;letter-spacing:-0.01em;line-height:1;margin-bottom:14px}[id*=\"stats-row\"] .multicolumn-card__title-wrapper{justify-content:center}<\/style>",
        "full_width": false,
        "show_divider": false,
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "compare-table": {
      "type": "landing-compare-table",
      "blocks": {
        "row-fragrance": {
          "type": "row",
          "settings": {
            "feature": "<p>No synthetic fragrance<\/p>",
            "us_has": true,
            "others_has": false,
            "why": "<p>Fragrance is the #1 self-reported skincare irritant. Pure Unscented means no perfume — and no masking fragrance.<\/p>"
          }
        },
        "row-essential-oils": {
          "type": "row",
          "settings": {
            "feature": "<p>No essential oils added (Pure Unscented)<\/p>",
            "us_has": true,
            "others_has": false,
            "why": "<p>Essential oils are still fragrance compounds. Many sensitive-skin folks react to them. The Pure Unscented variation has none.<\/p>"
          }
        },
        "row-petrolatum": {
          "type": "row",
          "settings": {
            "feature": "<p>No petrolatum or mineral oil<\/p>",
            "us_has": true,
            "others_has": false,
            "why": "<p>Petrolatum seals skin without feeding it. We use organic beeswax instead — breathable barrier, real ingredient.<\/p>"
          }
        },
        "row-dimethicone": {
          "type": "row",
          "settings": {
            "feature": "<p>No dimethicone<\/p>",
            "us_has": true,
            "others_has": false,
            "why": "<p>Silicones make creams feel slippery and absorb fast — a texture trick. We skip it.<\/p>"
          }
        },
        "row-parabens": {
          "type": "row",
          "settings": {
            "feature": "<p>No parabens or phenoxyethanol<\/p>",
            "us_has": true,
            "others_has": false,
            "why": "<p>Grapefruit seed extract is our natural preservative — it does the job without the synthetic preservatives many sensitive-skin folks avoid.<\/p>"
          }
        },
        "row-coldpressed": {
          "type": "row",
          "settings": {
            "feature": "<p>Cold-pressed virgin coconut oil<\/p>",
            "us_has": true,
            "others_has": false,
            "why": "<p>We use cold-pressed virgin coconut oil for its lauric acid and antioxidants — refining or fractionating coconut oil strips most of that out.<\/p>"
          }
        },
        "row-usa": {
          "type": "row",
          "settings": {
            "feature": "<p>Handmade in the USA<\/p>",
            "us_has": true,
            "others_has": false,
            "why": "<p>Small-batch means we know every ingredient in every lot — the kind of traceability sensitive skin shouldn't have to guess at.<\/p>"
          }
        }
      },
      "block_order": [
        "row-fragrance",
        "row-essential-oils",
        "row-petrolatum",
        "row-dimethicone",
        "row-parabens",
        "row-coldpressed",
        "row-usa"
      ],
      "settings": {
        "anchor_id": "compare",
        "heading": "<p>Sensitive Skin Set vs. The Drugstore Aisle<\/p>",
        "subheading": "<p>How we compare to Cetaphil, Aveeno, and CeraVe — the three biggest sensitive-skin drugstore brands.<\/p>",
        "us_image": "shopify:\/\/shop_images\/compare-thumb.png",
        "us_image_alt": "Sensitive Skin Set",
        "content_max_width": 1190,
        "padding_top": 48,
        "padding_bottom": 48,
        "text_color": "#212326",
        "border_color": "#E7E9EF",
        "divider_color": "#E7E9EF",
        "header_bg_color": "#FFFFFF",
        "us_bg_color": "#eef3e8",
        "us_border_color": "#a8d1a3",
        "aria_label": "Sensitive Skin Set vs Cetaphil Aveeno CeraVe comparison"
      }
    },
