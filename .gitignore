# Dependencies
# Both forms on purpose: the trailing slash matches the real directory, the bare
# name matches the symlink that scripts/new-worktree.sh drops into each worktree.
# Without the bare form a worktree reads as dirty and `git worktree remove` refuses.
node_modules/
node_modules

# Credentials — never commit
.env
client_secret_*.json
/Shopify/

# Large binary assets (images already live on Shopify CDN)
data/images/
data/product-images/

# Large Ahrefs/GSC raw export folders (regeneratable)
data/technical_seo/
data/keyword-tracker/
data/backlinks/
data/content_gap/
data/articles/

# Campaign data
data/campaigns/*.json

# Generated log files
data/logs/
data/reports/scheduler.log
data/reports/scheduler/
data/reports/backlink-monitor.log
data/reports/backlink-opportunity.log
data/reports/meta-optimizer.log
data/reports/meta-ab-checker.log
data/reports/content-refresher.log
data/reports/seo-reporter.log
data/reports/product-optimizer.log
data/reports/product-schema.log
data/reports/collection-creator.log
data/reports/cannibalization-resolver.log
data/reports/gsc-query-miner.log
data/reports/rank-tracker.log
data/reports/ads-optimizer.log
data/reports/ads-weekly-recap.log
data/reports/campaign-monitor.log
data/reports/campaign-analyzer.log
data/reports/daily-summary/
data/reports/cro/
data/reports/editor/

# Post-meta reconcile run records, backups and pre-pull snapshots.
# Deliberately NOT tracked: this directory is written by the deploy itself, on
# the production box. Tracking it would recreate the exact hazard the reconcile
# exists to fix — a tracked file that cron writes, colliding with the next pull.
data/reports/post-meta-reconcile/

# Generated agent reports (regenerable; not tracked)
data/reports/ai-citations/
data/reports/legacy-triage/
data/reports/llms-txt/
data/reports/plan6-cutover/
data/reports/product-verifier/
data/reports/seo-authority/
data/reports/sensitive-skin-set-validation/day-*.md
data/reports/cannibalization/publish-pending-drafts-report.md
data/reports/meta-optimizer/stale-years-report.md
data/reports/technical-seo/fix-results.json
data/reports/technical-seo/redirect-audit.json
data/reports/technical-seo/redirect-chains.json
data/reports/technical-seo/redirect-proposals.json

# Collector snapshots and raw data
data/snapshots/
data/clarity/

# Theme file backups (downloaded by apply-blog-sidebar.js)
backup/
theme/backups/

# Misc
Ingredients/
*.DS_Store
.worktrees/
.superpowers/
docs/google-ads-api-design-doc.html
amazon_product_photos/
data/amazon-explore/

# Change-log transient queue (contents ignored, .gitkeep tracked)
data/changes/queue/*.json
data/changes/queue/**/*.json
!data/changes/queue/.gitkeep
data/brand/_research/

# Performance queue — agent-generated PDP/cluster proposals + archived items
# Contents ignored; .gitkeep tracked
data/performance-queue/*.json
data/performance-queue/_archived-*/
!data/performance-queue/.gitkeep

# Generated keyword index (rebuilt by lib/keyword-index/ — large, regenerable)
data/keyword-index.json

# Per-slug agent analysis output (regenerable)
data/analysis/

# Dashboard background-run job logs (ephemeral)
data/reports/run-jobs/

# Marketing-learner transcript cache (large, re-fetchable, no review value)
data/marketing-corpus/

# Generated projection of .claude/skills/marketing-* — creative-packager builds it
# in memory at read time. Committing it made every concurrent learner PR conflict.
data/context/marketing-tactics.md

# Agent worktrees (one isolated checkout per concurrent session)
.claude/worktrees/

# Long-form source texts for marketing-learner --file (large, re-derivable from
# the operator's own copy, no review value in a diff). README only.
digitalassets/*
!digitalassets/README.md

# Generated digital-asset PDFs (build artifacts — source is assets/digital/)
data/digital-assets/

# runtime health-check artifact — regenerated every run, never reviewed in a diff
data/reports/ga4-health/
data/reports/giveaway/

# Google Ads offline conversion upload run reports (per-run, server-generated)
data/reports/ads-conversions/

# Shopping calibrator run reports (per-run, server-generated)
data/reports/shopping-calibrator/

# SEO impact run reports — server-authoritative (cron owns them) and never tracked, but
# a local `node agents/seo-impact/index.js` writes here and they showed up as untracked
# files waiting for someone's `git add .`
data/reports/seo-impact/

# Queue auto-apply run reports — same reasoning as seo-impact above: cron owns
# them on the server, and a local dry run would otherwise leave untracked files
# behind for someone's `git add .`
data/reports/queue-autoapply/

# Ad Studio run output — one default run writes ~137 MB of 2K renders (a single
# variation is ~7.6 MB × 6 platform targets). Regenerable and reviewed as images, never
# in a diff. Scoped to the ad-studio subtree so the already-tracked data/creatives/
# session-* masters are untouched. There is no retention policy yet: prune old run
# directories by hand — a full disk has already cost this project four days of cron.
data/creatives/ad-studio/

# Ad Studio score baseline — accumulates per environment from real runs, like the run
# output it summarises. Committing it would merge one machine's test runs into another's
# baseline, which is exactly the number it exists to keep honest.
data/reports/ad-studio/

# Per-run LLM spend telemetry, written by lib/llm-meter on every agent run.
# Machine-generated and append-only; scripts/llm-cost.mjs reads it locally.
data/reports/llm-usage/

# Ad Studio brief store — generated output. Scoped to the ad-studio subtree only:
# data/briefs/ itself already holds committed content-brief JSON for a different
# pipeline, and ignoring the parent would silently drop tracked files from future diffs.
data/briefs/ad-studio/

# data/briefs/_dropped/ is deliberately NOT ignored. It holds content briefs that
# scripts/triage-orphan-briefs.mjs took out of circulation, and archiving a tracked
# brief there is a rename git can follow and undo. Ignoring it would make the archive
# itself untracked — which is exactly the condition that made the 2026-08-19 loss of
# vegan-soap/oatmeal-soap/coconut-oil-soap-benefits unrecoverable. See lib/brief-archive.js.

# content-mirror live-body snapshots — read-only captures of what is on Shopify,
# written by scripts/check-content-mirrors.mjs --snapshot-live --apply purely so a
# human can diff them against the local mirror. Regenerable from Shopify, and a
# tracked copy would be one more stale body somebody later mistakes for current.
data/reports/content-mirror/
